-- ═══════════════════════════════════════════════════════════════
-- HDT — Head Direction Tracking
-- After block fires: lock character + camera onto killer
-- ═══════════════════════════════════════════════════════════════
local hdtConn = nil

local function StopHDT()
    if hdtConn then hdtConn:Disconnect(); hdtConn = nil end
end

local function StartHDT(killerRoot, duration)
    if not Settings.HDT then return end
    if not (killerRoot and killerRoot.Parent) then return end
    StopHDT()
    local t0  = tick()
    local cam = Workspace.CurrentCamera
    hdtConn = RunService.RenderStepped:Connect(function()
        if tick() - t0 >= (duration or Settings.HDTDuration) then StopHDT(); return end
        if not (killerRoot and killerRoot.Parent) then StopHDT(); return end
        local lr = AB.LocalRoot
        if not (lr and lr.Parent) then StopHDT(); return end
        local flat = Vector3.new(
            killerRoot.Position.X - lr.Position.X, 0,
            killerRoot.Position.Z - lr.Position.Z)
        if flat.Magnitude > 0 then
            lr.CFrame = CFrame.new(lr.Position, lr.Position + flat.Unit)
        end
        if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, killerRoot.Position) end
    end)
end

