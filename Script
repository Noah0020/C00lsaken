local function createSlider(title, minimum, maximum, default, callback, decimals)
    decimals = decimals or 0
    local mult = 10 ^ decimals

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 100)
    card.BackgroundColor3 = C.Panel
    card.BorderSizePixel = 0
    card.Parent = Content
    corner(card, 4)
    outline(card, Color3.fromRGB(45, 53, 63))

    local t = makeLabel(card, title, 14, C.White, Enum.Font.GothamBold)
    t.Position = UDim2.fromOffset(14, 8)
    t.Size = UDim2.new(1, -80, 0, 28)

    local valueLabel = makeLabel(card, string.format("%." .. decimals .. "f", default), 14, C.Yellow)
    valueLabel.Position = UDim2.new(1, -84, 0, 8)
    valueLabel.Size = UDim2.fromOffset(70, 28)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(14, 60)
    bar.Size = UDim2.new(1, -28, 0, 8)
    bar.BackgroundColor3 = C.Panel2
    bar.BorderSizePixel = 0
    bar.Parent = card
    corner(bar, 5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((default - minimum) / (maximum - minimum), 1)
    fill.BackgroundColor3 = C.Yellow
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 5)

    local dragging = false
    local value = default

    local function setValue(x)
        local percent = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local raw = minimum + percent * (maximum - minimum)
        value = math.floor(raw * mult + 0.5) / mult
        fill.Size = UDim2.fromScale(percent, 1)
        valueLabel.Text = string.format("%." .. decimals .. "f", value)
        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setValue(input.Position.X)
        end
    end)

    local changedConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setValue(input.Position.X)
        end
    end)

    local endedConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    card.Destroying:Connect(function()
        changedConn:Disconnect()
        endedConn:Disconnect()
    end)

    return {
        Get = function() return value end,
        Set = function(v)
            value = v
            local percent = math.clamp((v - minimum) / (maximum - minimum), 0, 1)
            fill.Size = UDim2.fromScale(percent, 1)
            valueLabel.Text = string.format("%." .. decimals .. "f", v)
        end
    }
end

