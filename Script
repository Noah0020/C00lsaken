-- ═══════════════════════════════════════════════════════════════
local StartAutoBlock, StopAutoBlock

function StartAutoBlock()
    if AB.running then return end
    AB.running = true; AB.generation = AB.generation+1; AB.attrStates = {}
    local myGen = AB.generation
    local char  = LocalPlayer.Character
    if char then
        AB.LocalRoot = char:FindFirstChild("HumanoidRootPart")
        MonitorBlockSuccess(char)
    end
    table.insert(AB.connections, LocalPlayer.CharacterAdded:Connect(function(c)
        AB.LocalRoot = c:WaitForChild("HumanoidRootPart", 5)
        MonitorBlockSuccess(c)
    end))
    local function attachKiller(k)
        if k and k:IsA("Model") then MonitorKillerSound(k) end
    end
    local function attachFolder(folder)
        if not folder then return false end
        AB.KillersFolder = folder
        table.insert(AB.connections, folder.ChildAdded:Connect(function(k)
            if AB.running and AB.generation==myGen then task.wait(0.1); attachKiller(k) end
        end))
        for _, k in ipairs(folder:GetChildren()) do attachKiller(k) end
        return true
    end
    local kf = GetKillersFolder()
    if not attachFolder(kf) then
        task.spawn(function()
            local t = 0
            while AB.running and AB.generation==myGen and t < 60 do
                t=t+1; task.wait(1)
                if attachFolder(GetKillersFolder()) then break end
            end
        end)
    end
    table.insert(AB.connections, RunService.Heartbeat:Connect(function()
        if AB.running and AB.generation==myGen then AttrHeartbeat() end
    end))
end

function StopAutoBlock()
    AB.running = false; AB.generation = AB.generation+1; AB.attrStates = {}
    for _, c in ipairs(AB.connections) do pcall(function() c:Disconnect() end) end
    AB.connections = {}
    StopHDT()
end

local function SetAutoBlock(value, mode)
    if mode == "custom" then
        Settings.AutoBlockCustom = value
        if value then Settings.AutoBlock = false end
    else
        Settings.AutoBlock = value
        if value then
            Settings.AutoBlockCustom = false
            -- Default ON → hide zone visuals, save memory
            if Settings.ShowDiamond then zoneStateMemory.diamond=true; Settings.ShowDiamond=false end
            if Settings.ShowCircle  then zoneStateMemory.circle =true; Settings.ShowCircle =false  end
            UpdateCustomZoneVisibility()
        end
    end
    if Settings.AutoBlock or Settings.AutoBlockCustom then
        if not AB.running then StartAutoBlock() end
    else
        if AB.running then StopAutoBlock() end
    end
    -- Sync toggles
    _suppressCB = true
    if Toggles.AutoBlock      then pcall(function() Toggles.AutoBlock:SetValue(Settings.AutoBlock)       end) end
    if Toggles.AutoBlockCustom then pcall(function() Toggles.AutoBlockCustom:SetValue(Settings.AutoBlockCustom) end) end
    _suppressCB = false
end

-- ═══════════════════════════════════════════════════════════════
-- 4TH BUTTON (goodsaken FourthBlock)
-- ═══════════════════════════════════════════════════════════════
local FourthBlock = {running=false, connections={}, instance=nil, sourceName=nil, cachedPos=nil, cachedSize=nil}

local function ApplyTint()
    local b = FourthBlock.instance; if not (b and b.Parent) then return end
    local col = (Settings.AutoBlock or Settings.AutoBlockCustom) and Color3.fromRGB(0,255,60) or Color3.fromRGB(220,0,0)
    if b:IsA("ImageButton") or b:IsA("ImageLabel") then b.ImageColor3=col end
    for _, d in ipairs(b:GetDescendants()) do
        if d:IsA("ImageLabel") or d:IsA("ImageButton") then d.ImageColor3=col
        elseif d:IsA("Frame") and d.BackgroundTransparency<1 then d.BackgroundColor3=col end
    end
end

local function StartFourthButton()
    if FourthBlock.running then return end
    FourthBlock.running=true; FourthBlock.connections={}
    local toggleCD = 0
    local function Toggle()
        if tick()-toggleCD < 0.15 then return end; toggleCD=tick()
        local t = Settings.FourthButtonTarget
        if t=="custom" then
            SetAutoBlock(not Settings.AutoBlockCustom, "custom")
        else
            SetAutoBlock(not Settings.AutoBlock, "default")
        end
        ApplyTint()
    end
    table.insert(FourthBlock.connections, RunService.RenderStepped:Connect(function()
        local b = FourthBlock.instance
        if b and b.Parent then
            pcall(function() FourthBlock.cachedPos=b.AbsolutePosition; FourthBlock.cachedSize=b.AbsoluteSize end)
        else FourthBlock.cachedPos=nil; FourthBlock.cachedSize=nil end
    end))
    local function OnButton(pos)
        local b = FourthBlock.instance; if not (b and b.Parent) then return false end
        local ok,objs = pcall(function() return UserInputService:GetGuiObjectsAtPosition(pos.X,pos.Y) end)
        if ok and objs and #objs>0 then return objs[1]==b or objs[1]:IsDescendantOf(b) end
        if not FourthBlock.cachedPos then return false end
        local p,s = FourthBlock.cachedPos, FourthBlock.cachedSize
        return pos.X>=p.X and pos.X<=p.X+s.X and pos.Y>=p.Y and pos.Y<=p.Y+s.Y
    end
    local downPos, downTime = nil, 0
    table.insert(FourthBlock.connections, UserInputService.InputBegan:Connect(function(input)
        if not FourthBlock.running then return end
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        if OnButton(input.Position) then downPos=input.Position; downTime=tick() end
    end))
    table.insert(FourthBlock.connections, UserInputService.InputEnded:Connect(function(input)
        if not FourthBlock.running then return end
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        if not downPos then return end
        local held = tick()-downTime; downPos=nil
        if held>0.5 then return end
        if OnButton(input.Position) then Toggle() end
    end))
    local function BindBtn(obj)
        if obj:IsA("GuiButton") then
            pcall(function() obj.MouseButton1Click:Connect(Toggle) end)
            pcall(function() obj.Activated:Connect(Toggle) end)
        end
    end
    task.spawn(function()
        while FourthBlock.running do task.wait(0.5)
            local m = PlayerGui:FindFirstChild("MainUI"); if not m then continue end
            local c = m:FindFirstChild("AbilityContainer",true); if not c then continue end
            local blockBtn = c:FindFirstChild("Block"); local cloneBtn = c:FindFirstChild("Clone")
            local mode = Settings.AutoBlockCustom and Settings.CustomABMode or Settings.ABMode
            local orig = (blockBtn and cloneBtn) and ((mode=="007n7") and cloneBtn or blockBtn) or (blockBtn or cloneBtn)
            local e = c:FindFirstChild("FourthBlockAbility")
            if not e and orig then
                local cl = orig:Clone(); cl.Name="FourthBlockAbility"; cl.LayoutOrder=4
                for _, d in ipairs(cl:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local t = d.Text:lower()
                        if t:find("block") or t:find("clone") then d.Text=""; d.Visible=false end
                    end
                    if d:IsA("GuiObject") then d.ZIndex=math.max(d.ZIndex,50); d.Active=true end
                end
                cl.Parent=c; FourthBlock.instance=cl; FourthBlock.sourceName=orig.Name
                BindBtn(cl); for _, d in ipairs(cl:GetDescendants()) do BindBtn(d) end
                ApplyTint()
            elseif e and FourthBlock.instance~=e then
                FourthBlock.instance=e; BindBtn(e)
                for _, d in ipairs(e:GetDescendants()) do BindBtn(d) end
                ApplyTint()
            end
        end
    end)
end

local function StopFourthButton()
    if not FourthBlock.running then return end
    FourthBlock.running=false
    for _, c in ipairs(FourthBlock.connections) do pcall(function() c:Disconnect() end) end
    FourthBlock.connections={}
    if FourthBlock.instance and FourthBlock.instance.Parent then
        pcall(function() FourthBlock.instance:Destroy() end)
    end
    FourthBlock.instance=nil; FourthBlock.cachedPos=nil; FourthBlock.cachedSize=nil
end

-- ═══════════════════════════════════════════════════════════════
-- ESP — meowsaken style (Highlight + BillboardGui with distance)
-- ═══════════════════════════════════════════════════════════════
local killerHighlights   = {}
local survivorHighlights = {}
local espBillboards      = {}
local espRunConn         = nil
local killerEspThread    = nil
local survivorEspThread  = nil

local function GetSurvivorsFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Survivors")
end

local function MakeBillboard(model)
    local root = model:FindFirstChild("HumanoidRootPart"); if not root then return end
    local bb = Instance.new("BillboardGui")
    bb.Name="_C00lESPBB"; bb.Size=UDim2.new(0,120,0,22)
    bb.StudsOffset=Vector3.new(0,3.5,0); bb.AlwaysOnTop=true
    bb.MaxDistance=800; bb.Adornee=root; bb.Parent=model
    local lbl = Instance.new("TextLabel")
    lbl.Name="_lbl"; lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
    lbl.TextColor3=Color3.new(1,1,1); lbl.TextStrokeTransparency=0.3
    lbl.TextStrokeColor3=Color3.new(0,0,0); lbl.TextSize=13
    lbl.Font=Enum.Font.GothamBold; lbl.Text=model.Name; lbl.Parent=bb
    espBillboards[model]=bb
end

local function CreateKillerHighlight(model)
    if model:FindFirstChild("_C00lKillerESP") then return end
    local h = Instance.new("Highlight"); h.Name="_C00lKillerESP"
    h.Adornee=model; h.FillColor=Color3.fromRGB(220,0,0)
    h.OutlineColor=Color3.fromRGB(255,60,60)
    h.FillTransparency=0.65; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=model
    table.insert(killerHighlights, h); MakeBillboard(model)
end

local function ClearKillerHighlights()
    for _, h in ipairs(killerHighlights) do if h and h.Parent then h:Destroy() end end
    killerHighlights={}
    for model, bb in pairs(espBillboards) do
        local kf = GetKillersFolder()
        if kf and model:IsDescendantOf(kf) then
            if bb and bb.Parent then bb:Destroy() end
            espBillboards[model]=nil
        end
    end
end

local function UpdateKillerESP()
    ClearKillerHighlights()
    local kf = GetKillersFolder(); if not kf then return end
    for _, k in ipairs(kf:GetChildren()) do
        if k:IsA("Model") and k:FindFirstChild("HumanoidRootPart") then
            CreateKillerHighlight(k)
        end
    end
end

local function CreateSurvivorHighlight(model)
    if model == LocalPlayer.Character then return end
    if model:FindFirstChild("_C00lSurvESP") then return end
    local h = Instance.new("Highlight"); h.Name="_C00lSurvESP"
    h.Adornee=model; h.FillColor=Color3.fromRGB(0,180,255)
    h.OutlineColor=Color3.fromRGB(80,220,255)
    h.FillTransparency=0.65; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=model
    table.insert(survivorHighlights, h); MakeBillboard(model)
end

local function ClearSurvivorHighlights()
    for _, h in ipairs(survivorHighlights) do if h and h.Parent then h:Destroy() end end
    survivorHighlights={}
    for model, bb in pairs(espBillboards) do
        local sf = GetSurvivorsFolder()
        if sf and model:IsDescendantOf(sf) then
            if bb and bb.Parent then bb:Destroy() end
            espBillboards[model]=nil
        end
    end
end

local function UpdateSurvivorESP()
    ClearSurvivorHighlights()
    local sf = GetSurvivorsFolder(); if not sf then return end
    for _, s in ipairs(sf:GetChildren()) do
        if s:IsA("Model") and s:FindFirstChild("HumanoidRootPart") and s~=LocalPlayer.Character then
            CreateSurvivorHighlight(s)
        end
    end
end

local function StartESPDistanceLoop()
    if espRunConn then return end
    local lr = AB.LocalRoot or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
    espRunConn = RunService.Heartbeat:Connect(function()
        lr = AB.LocalRoot or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
        if not lr then return end
        for model, bb in pairs(espBillboards) do
            if not model.Parent then espBillboards[model]=nil; continue end
            local root = model:FindFirstChild("HumanoidRootPart")
            local lbl  = bb:FindFirstChild("_lbl")
            if lbl and root then
                local dist = math.floor((root.Position-lr.Position).Magnitude)
                lbl.Text = model.Name.." ["..dist.."m]"
            end
        end
    end)
end

local function StopESPDistanceLoop()
    if espRunConn then espRunConn:Disconnect(); espRunConn=nil end
end

local function EnableKillerESP()
    if killerEspThread then task.cancel(killerEspThread); killerEspThread=nil end
    killerEspThread = task.spawn(function()
        while Settings.ESPKillers do UpdateKillerESP(); task.wait(2) end
    end)
    StartESPDistanceLoop()
end

local function DisableKillerESP()
    if killerEspThread then task.cancel(killerEspThread); killerEspThread=nil end
    ClearKillerHighlights()
    if not Settings.ESPSurvivors then StopESPDistanceLoop() end
end

local function EnableSurvivorESP()
    if survivorEspThread then task.cancel(survivorEspThread); survivorEspThread=nil end
    survivorEspThread = task.spawn(function()
        while Settings.ESPSurvivors do UpdateSurvivorESP(); task.wait(2) end
    end)
    StartESPDistanceLoop()
end

local function DisableSurvivorESP()
    if survivorEspThread then task.cancel(survivorEspThread); survivorEspThread=nil end
    ClearSurvivorHighlights()
    if not Settings.ESPKillers then StopESPDistanceLoop() end
end

