local function bsGetKillerFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function bsGetFirstValidKiller()
    local folder = bsGetKillerFolder()
    if not folder then return nil end
    for _, inst in ipairs(folder:GetChildren()) do
        if inst:IsA("Model") then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            local hrp = inst:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return inst
            end
        end
    end
    return nil
end

local function bsRefreshSpeed()
    local char = LocalPlayer.Character
    if not char then BS_speedValue = nil; return end
    local sm = char:FindFirstChild("SpeedMultipliers")
    if not sm then BS_speedValue = nil; return end
    BS_speedValue = sm:FindFirstChild("Sprinting")
end

local function bsGetPing()
    local ok, val = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and val then return val end
    local ok2, val2 = pcall(function() return LocalPlayer:GetNetworkPing() * 1000 end)
    if ok2 and val2 then return val2 end
    return 20
end

-- Network hook
local bsHookInstalled = false

local function bsInstallHook()
    if bsHookInstalled then return true end
    if not BS_NetworkModule or not BS_CharacterReplication then return false end
    if not hookfunction then
        warn("[c00lsaken] Backstab hook: hookfunction unavailable.")
        return false
    end

    local ok, err = pcall(function()
        local oldFire
        oldFire = hookfunction(BS_NetworkModule.FireServerConnection, function(self, connectionName, eventType, ...)
            local args = {...}

            if connectionName == "UpdateCharacterPosition" then
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                local killerModel = bsGetFirstValidKiller()

                if killerModel and hrp then
                    local killerHrp = killerModel:FindFirstChild("HumanoidRootPart")
                    if killerHrp then
                        local ok2, serialized = pcall(function()
                            if BS_moredirectrn then
                                local targetdirect = hrp.CFrame * CFrame.new(0, -90000, 0)
                                return BS_CharacterReplication.Serialize(targetdirect, hrp.AssemblyLinearVelocity)
                            elseif BS_moredirectend then
                                local targetdirectend = hrp.CFrame * CFrame.new(0, 0, 0)
                                return BS_CharacterReplication.Serialize(targetdirectend, hrp.AssemblyLinearVelocity)
                            elseif BS_doitmate then
                                local targetCFrame = killerHrp.CFrame * CFrame.new(0, 0, BS_CFG.BehindStuds)
                                return BS_CharacterReplication.Serialize(targetCFrame, hrp.AssemblyLinearVelocity)
                            end
                            return nil
                        end)

                        if ok2 and serialized then
                            args[1] = serialized
                        end
                    end
                end
            end

            return oldFire(self, connectionName, eventType, unpack(args))
        end)
    end)

    if ok then
        bsHookInstalled = true
        print("[c00lsaken] Backstab network hook installed.")
        return true
    end

    warn("[c00lsaken] Backstab hook install failed: " .. tostring(err))
    return false
end

task.spawn(function()
    local attempts = 0
    while attempts < 60 do
        if BS_NetworkModule and BS_CharacterReplication then
            bsInstallHook()
            return
        end
        attempts = attempts + 1
        task.wait(0.5)
    end
    warn("[c00lsaken] Backstab hook: modules never appeared after 30s.")
end)

-- Stab sequence
local function bsRunSequence(isDashstab)
    if BS_running then return end
    BS_running = true

    local startDelay = isDashstab and BS_CFG.DashStartDelay or BS_CFG.StartDelay
    local mdWait     = isDashstab and 0.001 or 0.01

    local success, err = pcall(function()
        task.wait(startDelay)

        local character = LocalPlayer.Character
        if not character then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        bsRefreshSpeed()
        local oldSpeed = BS_speedValue and BS_speedValue.Value

        if BS_CFG.MoreDirect then
            BS_moredirectrn = true
            task.wait(mdWait)
            BS_moredirectrn = false
        end

        if BS_speedValue then BS_speedValue.Value = 0 end
        BS_doitmate = true

        local startTime = os.clock()
        while os.clock() - startTime < BS_CFG.Duration do
            if not character.Parent then break end
            if not (BS_CFG.NormalEnabled or BS_CFG.DashstabEnabled) then break end
            RunService.RenderStepped:Wait()
        end

        BS_doitmate = false
        if BS_speedValue and oldSpeed then BS_speedValue.Value = oldSpeed end

        if BS_CFG.MoreDirect then
            BS_moredirectrn = true
            task.wait(mdWait)
            BS_moredirectend = true
            BS_moredirectrn = false
            task.wait(mdWait)
            BS_moredirectend = false
        end
    end)

    BS_doitmate      = false
    BS_moredirectrn  = false
    BS_moredirectend = false
    BS_running       = false

    if not success then
        warn("[c00lsaken] Backstab sequence error: " .. tostring(err))
    end
end

-- Trigger
local function bsOnStabAnimation(isDashstab)
    if BS_running then return end
    if isDashstab and not BS_CFG.DashstabEnabled then return end
    if not isDashstab and not BS_CFG.NormalEnabled then return end

    local now = os.clock()
    if now - BS_lastStab < BS_CFG.Cooldown then return end

    if BS_CFG.DistCheck then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local killer = bsGetFirstValidKiller()
        local khrp = killer and killer:FindFirstChild("HumanoidRootPart")
        if not hrp or not khrp then return end
        if (hrp.Position - khrp.Position).Magnitude > BS_CFG.DistCheckStuds then return end
    end

    BS_lastStab = now
    task.spawn(bsRunSequence, isDashstab)
end

_G.C00lsakenBackstab = function()
    if BS_CFG.NormalEnabled then
        bsOnStabAnimation(false)
    elseif BS_CFG.DashstabEnabled then
        bsOnStabAnimation(true)
    else
        warn("[c00lsaken] Backstab: enable Normal or Dashstab first.")
    end
end

-- Animation binding
local bsHookedAnimators = setmetatable({}, {__mode = "k"})

local function bsHookAnimator(animator)
    if not animator or not animator:IsA("Animator") then return end
    if bsHookedAnimators[animator] then return end
    bsHookedAnimators[animator] = true

    animator.AnimationPlayed:Connect(function(track)
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId):match("%d+")
        if not id then return end

        if BS_NORMAL_STAB_IDS[id] then
            bsOnStabAnimation(false)
        elseif BS_CROUCH_STAB_IDS[id] then
            bsOnStabAnimation(true)
        end
    end)
end

local function bsBindCharacter(character)
    if not character then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local anim = hum:FindFirstChildOfClass("Animator")
    if anim then bsHookAnimator(anim) end

    hum.ChildAdded:Connect(function(child)
        if child:IsA("Animator") then
            bsHookAnimator(child)
        end
    end)

    character.ChildAdded:Connect(function(child)
        if child.Name == "SpeedMultipliers" then
            bsRefreshSpeed()
        end
    end)

    bsRefreshSpeed()
end

