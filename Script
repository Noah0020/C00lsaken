local ABT = { running=false, animConn=nil, cleanup=nil, charConn=nil }

local function ABT_Stop()
    if ABT.cleanup then ABT.cleanup() end
    if ABT.animConn then pcall(function() ABT.animConn:Disconnect() end); ABT.animConn=nil end
    if ABT.charConn then pcall(function() ABT.charConn:Disconnect() end); ABT.charConn=nil end
    ABT.running = false
end

local function ABT_RunSequence(character)
    if not ABT.running or ABT.cleanup then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local kf = GetKillersFolder(); if not hrp or not kf then return end
    local killer = kf:FindFirstChildOfClass("Model")
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart"); if not khrp then return end

    local oldPart = character.PrimaryPart
    local part = Instance.new("Part")
    part.Name="GS_ABT"; part.Size=Vector3.new(2,2,2); part.Transparency=1
    part.CanCollide=false; part.Massless=true; part.CFrame=hrp.CFrame; part.Parent=character
    character.PrimaryPart = part

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero; bv.Parent = part

    local speed, elapsed, reachedTime = 100, 0, 0
    local reached, finished = false, false
    local conn

    local function cleanup()
        if finished then return end; finished = true
        if conn then conn:Disconnect() end
        if character and character.Parent and oldPart then character.PrimaryPart = oldPart end
        if bv and bv.Parent then bv:Destroy() end
        if part and part.Parent then part:Destroy() end
        ABT.cleanup = nil
    end
    ABT.cleanup = cleanup

    conn = RunService.RenderStepped:Connect(function(dt)
        if not ABT.running or not character.Parent or not part.Parent or not khrp.Parent then cleanup(); return end
        character.PrimaryPart = part
        local target = khrp.Position + khrp.CFrame.LookVector * 2
        local diff = target - part.Position
        local dist = diff.Magnitude
        if reached then
            reachedTime = reachedTime + dt
            bv.Velocity = dist > 0.1 and diff.Unit * speed or Vector3.zero
            if reachedTime >= Settings.ABT_Duration then cleanup() end
            return
        end
        elapsed = elapsed + dt
        if dist <= speed*dt or dist < 0.1 then
            bv.Velocity = Vector3.zero; reached = true; reachedTime = 0; return
        end
        bv.Velocity = diff.Unit * speed
        if elapsed >= 1 then cleanup() end
    end)
end

local function ABT_Attach(char)
    local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
    local anim = hum:WaitForChild("Animator", 5); if not anim then return end
    if ABT.animConn then pcall(function() ABT.animConn:Disconnect() end) end
    ABT.animConn = anim.AnimationPlayed:Connect(function(track)
        if not ABT.running then return end
        local aid = track.Animation and track.Animation.AnimationId
        if aid and AntiBaitAnims[aid] then task.spawn(ABT_RunSequence, char) end
    end)
end

local function ABT_Enable()
    if ABT.running then return end
    ABT.running = true
    if LocalPlayer.Character then task.spawn(ABT_Attach, LocalPlayer.Character) end
    ABT.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
        if ABT.running then task.spawn(ABT_Attach, c) end
    end)
end
local function ABT_Disable() ABT_Stop() end

