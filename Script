local killerESPActive, killerHighlights, killerESPThread = false, {}, nil
local survivorESPActive, survivorHighlights, survivorESPThread = false, {}, nil

local function clearHighlights(list)
    for _, h in ipairs(list) do
        if h and h.Parent then h:Destroy() end
    end
    for i = #list, 1, -1 do list[i] = nil end
end

local function addHighlight(model, color)
    local hl = Instance.new("Highlight")
    hl.Adornee = model
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    return hl
end

local function updateKillerESP()
    if not killersFolder then return end
    clearHighlights(killerHighlights)
    for _, k in ipairs(killersFolder:GetChildren()) do
        if k:IsA("Model") and k:FindFirstChild("HumanoidRootPart") then
            table.insert(killerHighlights, addHighlight(k, Color3.fromRGB(255, 0, 0)))
        end
    end
end

local function updateSurvivorESP()
    if not survivorsFolder then return end
    clearHighlights(survivorHighlights)
    for _, s in ipairs(survivorsFolder:GetChildren()) do
        if s:IsA("Model") and s ~= LocalPlayer.Character and s:FindFirstChild("HumanoidRootPart") then
            table.insert(survivorHighlights, addHighlight(s, Color3.fromRGB(0, 255, 0)))
        end
    end
end

local medkitActive, bloxyActive = false, false
local itemHighlights = { Medkit = {}, BloxyCola = {} }

local function applyItemHighlight(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    local name = item.Name
    if name ~= "Medkit" and name ~= "BloxyCola" then return end
    local isMedkit = (name == "Medkit" and medkitActive)
    local isBloxy = (name == "BloxyCola" and bloxyActive)
    if not (isMedkit or isBloxy) then return end
    local targetPart = item:IsA("BasePart")
        and item
        or item:FindFirstChildWhichIsA("BasePart", true)
    if not targetPart or targetPart:FindFirstChild("ItemHighlight") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "ItemHighlight"
    hl.Adornee = item
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if isMedkit then
        hl.FillColor = Color3.fromRGB(255, 105, 180)
        hl.OutlineColor = Color3.fromRGB(255, 105, 180)
        table.insert(itemHighlights.Medkit, hl)
    else
        hl.FillColor = Color3.fromRGB(0, 150, 255)
        hl.OutlineColor = Color3.fromRGB(0, 150, 255)
        table.insert(itemHighlights.BloxyCola, hl)
    end
    hl.Parent = targetPart
end

local function clearItemESP(name)
    clearHighlights(itemHighlights[name])
end

local genESPActive = false
local genConns = {}

local function attachGeneratorESP(obj)
    if not obj or not obj.Parent then return end
    pcall(function()
        local old = obj:FindFirstChild("esp_g"); if old then old:Destroy() end
        local oldbb = obj:FindFirstChild("esp_g_bb"); if oldbb then oldbb:Destroy() end
    end)
    if genConns[obj] then pcall(function() genConns[obj]:Disconnect() end); genConns[obj] = nil end

    local root

    if obj:IsA("Model") then
        root = obj.PrimaryPart
            or obj:FindFirstChild("Base")
            or obj:FindFirstChild("Main")
            or obj:FindFirstChildWhichIsA("BasePart", true)
    elseif obj:IsA("BasePart") then
        root = obj
    end

    if not root then return end

    pcall(function()
        local hl = Instance.new("Highlight")
        hl.Name = "esp_g"; hl.FillColor = Color3.fromRGB(255, 255, 0)
        hl.FillTransparency = 0.6; hl.OutlineColor = Color3.fromRGB(255, 255, 0)
        hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = obj; hl.Parent = obj

        local bb = Instance.new("BillboardGui")
        bb.Name = "esp_g_bb"; bb.Adornee = root
        bb.Size = UDim2.new(0, 100, 0, 20); bb.StudsOffset = Vector3.new(0, 3.8, 0)
        bb.AlwaysOnTop = true; bb.MaxDistance = 1000; bb.Parent = obj

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
        lbl.TextStrokeTransparency = 0.5; lbl.TextSize = 14
        lbl.Font = Enum.Font.SourceSansBold; lbl.Parent = bb

        local prog = obj:FindFirstChild("Progress")
        if prog and prog:IsA("NumberValue") then
            lbl.Text = "Gen " .. math.floor(prog.Value) .. "%"
            genConns[obj] = prog.Changed:Connect(function()
                if lbl.Parent then lbl.Text = "Gen " .. math.floor(prog.Value) .. "%" end
            end)
        else lbl.Text = "Gen" end
    end)
end

local function detachGeneratorESP(obj)
    if not obj then return end
    if genConns[obj] then pcall(function() genConns[obj]:Disconnect() end); genConns[obj] = nil end
    pcall(function()
        local h = obj:FindFirstChild("esp_g"); if h then h:Destroy() end
        local b = obj:FindFirstChild("esp_g_bb"); if b then b:Destroy() end
    end)
end

local function scanGenerators(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if on then attachGeneratorESP(obj) else detachGeneratorESP(obj) end
        end
    end
end

Workspace.DescendantAdded:Connect(function(d)
    if (medkitActive or bloxyActive) and (d.Name == "Medkit" or d.Name == "BloxyCola") then
        task.spawn(function() task.wait(0.1); applyItemHighlight(d) end)
    end
    if genESPActive and d.Name == "Generator" then
        task.spawn(function() task.wait(0.1); attachGeneratorESP(d) end)
    end
end)

