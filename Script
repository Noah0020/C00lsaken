local AB = { running=false, loop=nil, playedOut={}, blocked={}, coneValid={}, visual={} }
local RED, GREEN = Color3.fromRGB(255,70,70), Color3.fromRGB(70,255,120)

local function AB_FireBlock()
    if not NetworkEvent then return end
    local name = Settings.AB_Mode == "007n7" and "Clone" or "Block"
    pcall(function() NetworkEvent:FireServer("UseActorAbility", {name}) end)
    if buffer and buffer.fromstring then
        pcall(function() NetworkEvent:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0"..name) }) end)
    end
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild(name)
    if btn and firesignal then
        local sig = btn:FindFirstChildOfClass("MouseButton1Click")
        if sig then pcall(firesignal, sig) end
    end
end

local function AB_RemoveVisual(model)
    local v = AB.visual[model]
    if v and v.folder then v.folder:Destroy() end
    AB.visual[model] = nil; AB.coneValid[model] = nil
end

local function AB_MakePart(folder)
    local p = Instance.new("Part")
    p.Anchored=true; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.CastShadow=false
    p.Material=Enum.Material.SmoothPlastic; p.Transparency=0.78; p.Parent=folder
    return p
end

local function AB_UpdateVisual(model, hrp)
    if not hrp or not hrp.Parent then AB_RemoveVisual(model); return end
    if not Settings.AB_RangeVisual and not Settings.AB_FacingCheck then AB_RemoveVisual(model); return end
    if not LocalRoot or not LocalRoot.Parent then return end

    local v = AB.visual[model]
    if not v then
        local folder = Instance.new("Folder"); folder.Name="GS_AB_Visual"; folder.Parent=Workspace
        v = { folder=folder, parts={}, mode=nil }; AB.visual[model]=v
    end

    local origin, range = hrp.Position, Settings.AB_Range
    local off = LocalRoot.Position - origin
    local flatOff = Vector3.new(off.X, 0, off.Z)
    local dist = flatOff.Magnitude
    local inRange = dist <= range

    local inFacing = true
    if Settings.AB_FacingCheck and dist > 0.001 then
        local lv = hrp.CFrame.LookVector
        local flatLook = Vector3.new(lv.X, 0, lv.Z)
        if flatLook.Magnitude > 0.001 and flatOff.Magnitude > 0.001 then
            inFacing = flatLook.Unit:Dot(flatOff.Unit) > Settings.AB_Dot
        end
    end

    local valid
    if Settings.AB_FacingCheck then valid = inRange and inFacing else valid = inRange end
    AB.coneValid[model] = valid
    local color = valid and GREEN or RED

    if not Settings.AB_FacingCheck then
        if v.mode ~= "Circle" then
            for _, p in ipairs(v.parts) do p:Destroy() end; table.clear(v.parts)
            local c = AB_MakePart(v.folder); c.Shape=Enum.PartType.Cylinder
            v.circle=c; v.mode="Circle"; table.insert(v.parts, c)
        end
        v.circle.Color = color
        v.circle.Size = Vector3.new(0.12, range*2, range*2)
        v.circle.CFrame = CFrame.new(origin + Vector3.new(0,0.04,0)) * CFrame.Angles(0,0,math.rad(90))
        return
    end

    if v.mode ~= "FacingOutline" then
        for _, p in ipairs(v.parts) do p:Destroy() end; table.clear(v.parts)
        v.mode = "FacingOutline"
        for i=1,4 do
            local p = AB_MakePart(v.folder); p.Transparency = Settings.AB_RangeVisual and 0 or 1
            table.insert(v.parts, p)
        end
        for i=1,3 do
            local b = Instance.new("Part")
            b.Shape=Enum.PartType.Ball; b.Anchored=true; b.CanCollide=false
            b.CanTouch=false; b.CanQuery=false; b.CastShadow=false
            b.Material=Enum.Material.SmoothPlastic; b.Size=Vector3.new(0.65,0.65,0.65)
            b.Transparency = Settings.AB_RangeVisual and 0 or 1
            b.Parent=v.folder; table.insert(v.parts, b)
        end
    end

    local halfAngle = math.acos(math.clamp(Settings.AB_Dot, -1, 1))
    local lv = hrp.CFrame.LookVector
    local flatFwd = Vector3.new(lv.X, 0, lv.Z)
    if flatFwd.Magnitude < 0.001 then return end
    flatFwd = flatFwd.Unit
    local right = Vector3.new(-flatFwd.Z, 0, flatFwd.X)
    local leftDir  = (flatFwd*math.cos(halfAngle) - right*math.sin(halfAngle)).Unit
    local rightDir = (flatFwd*math.cos(halfAngle) + right*math.sin(halfAngle)).Unit
    local yOff = 0.08
    local oP  = origin + Vector3.new(0,yOff,0)
    local lP  = origin + leftDir*range + Vector3.new(0,yOff,0)
    local rP  = origin + rightDir*range + Vector3.new(0,yOff,0)
    local bP  = origin + flatFwd*range + Vector3.new(0,yOff,0)

    local function posLine(part, a, b)
        local diff = b - a; local len = diff.Magnitude
        if len <= 0.001 then part.Transparency = 1; return end
        part.Transparency = Settings.AB_RangeVisual and 0 or 1
        part.Color = color; part.Size = Vector3.new(0.12,0.12,len)
        part.CFrame = CFrame.lookAt((a+b)/2, b)
    end
    posLine(v.parts[1], oP, lP); posLine(v.parts[2], oP, rP)
    posLine(v.parts[3], lP, bP); posLine(v.parts[4], rP, bP)

    local lp, rp, bp = v.parts[5], v.parts[6], v.parts[7]
    lp.Color, rp.Color, bp.Color = color, color, color
    lp.Position, rp.Position, bp.Position = lP, rP, bP
    lp.Transparency = Settings.AB_RangeVisual and 0 or 1
    rp.Transparency = Settings.AB_RangeVisual and 0 or 1
    bp.Transparency = Settings.AB_RangeVisual and 0 or 1
end

local function AB_CheckSound(model, hrp, root)
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("Sound") and ValidSounds[obj.SoundId] then
            if obj.IsPlaying then
                local inR = (root.Position - hrp.Position).Magnitude <= Settings.AB_Range
                local canBlock = Settings.AB_FacingCheck and (AB.coneValid[model]==true) or inR
                if AB.playedOut[obj] == nil then AB.playedOut[obj] = not inR end
                if canBlock and not AB.playedOut[obj] and not AB.blocked[obj] then
                    AB.blocked[obj] = true; AB_FireBlock()
                end
            else
                AB.playedOut[obj] = nil; AB.blocked[obj] = nil
            end
        end
    end
end

local function AB_CheckAnim(model, hrp, root)
    local hum = model:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator"); if not anim then return end
    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
        local aid = track.Animation and track.Animation.AnimationId
        if aid and ValidAnimations[aid] then
            local inR = (root.Position - hrp.Position).Magnitude <= Settings.AB_Range
            local canBlock = Settings.AB_FacingCheck and (AB.coneValid[model]==true) or inR
            if AB.playedOut[track] == nil then AB.playedOut[track] = not inR end
            if canBlock and not AB.playedOut[track] and not AB.blocked[track] then
                AB.blocked[track] = true; AB_FireBlock()
            end
        end
    end
end

local function AB_Loop()
    while AB.running do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            local kf = GetKillersFolder()
            if kf then
                for _, m in ipairs(kf:GetChildren()) do
                    if m:IsA("Model") and m.Parent then
                        local hrp = m:FindFirstChild("HumanoidRootPart")
                        if hrp and hrp.Parent then
                            if Settings.AB_BlockType == "Sound" then AB_CheckSound(m, hrp, root)
                            else AB_CheckAnim(m, hrp, root) end
                        end
                    end
                end
            end
            for obj in pairs(AB.playedOut) do
                if typeof(obj) == "Instance"
                   and (obj:IsA("AnimationTrack") or obj:IsA("Sound"))
                   and not obj.IsPlaying then
                    AB.playedOut[obj] = nil; AB.blocked[obj] = nil
                end
            end
        end
        task.wait(0.1)
    end
end

local function AB_Enable()
    if AB.running then return end
    AB.running = true; table.clear(AB.playedOut); table.clear(AB.blocked)
    AB.loop = task.spawn(AB_Loop)
end
local function AB_Disable()
    AB.running = false
    if AB.loop then pcall(task.cancel, AB.loop); AB.loop = nil end
    table.clear(AB.playedOut); table.clear(AB.blocked)
end

RunService.RenderStepped:Connect(function()
    if Settings.AB_RangeVisual or Settings.AB_FacingCheck then
        local kf = GetKillersFolder()
        if kf then
            for _, m in ipairs(kf:GetChildren()) do
                if m:IsA("Model") then AB_UpdateVisual(m, m:FindFirstChild("HumanoidRootPart")) end
            end
        end
        for m in pairs(AB.visual) do if not m.Parent then AB_RemoveVisual(m) end end
    else
        for m in pairs(AB.visual) do AB_RemoveVisual(m) end
    end
end)

