local function AimLockLoop(k, mr, h)
    local st = tick()
    while Aimbot.active do
        if not Aimbot.enabled then break end
        if tick() - st > State.AimLockDuration then break end
        if not k or not k.Parent then break end
        local kr = k:FindFirstChild("HumanoidRootPart")
        if not kr then break end
        if not mr or not mr.Parent then break end
        if (kr.Position - mr.Position).Magnitude < State.AimMinDistance then break end
        local pred = kr.Position + (kr.CFrame.LookVector * State.AimPrediction)
        if State.CharLock then pcall(function() mr.CFrame = CFrame.lookAt(mr.Position, pred) end) end
        if State.CamLock then
            local cam = Workspace.CurrentCamera
            if cam then pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pred) end) end
        end
        task.wait()
    end
    Aimbot.active = false
    if h then pcall(function() h.AutoRotate = true end) end
end

