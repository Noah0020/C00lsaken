-- AB DETECTION (goodsaken sound + attribute paths)
-- ═══════════════════════════════════════════════════════════════
local function MonitorKillerSound(killer)
    if not killer then return end
    local function tryBlock(snd)
        if not AB.running then return end
        if not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
        if not snd or not snd:IsA("Sound") then return end
        local sid = snd.SoundId; if sid == "" then return end
        local n   = sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
        local isM1 = M1_Sounds[sid] or (n and (M1_Sounds["rbxassetid://"..n] or M1_Sounds[n]))
        if not isM1 then return end
        if not AB.LocalRoot then return end
        local kr = killer:FindFirstChild("HumanoidRootPart")
        if not (kr and kr.Parent) then return end
        if Settings.AutoBlockCustom then
            if not IsPlayerInCustomZone(killer) then return end
        else
            local dir = AB.LocalRoot.Position - kr.Position; local mag = dir.Magnitude
            if mag > 15 then return end
            if mag > 0 and kr.CFrame.LookVector:Dot(dir.Unit) < 0.3 then return end
        end
        local now = tick()
        if now - AB.blueDebounce < 0.15 then return end
        AB.blueDebounce = now
        FireAbilityByMode()
        -- HDT immediately on block fire
        if Settings.HDT then task.spawn(function() StartHDT(kr, Settings.HDTDuration) end) end
    end
    for _, d in ipairs(killer:GetDescendants()) do if d:IsA("Sound") then tryBlock(d) end end
    table.insert(AB.connections, killer.DescendantAdded:Connect(tryBlock))
end

local function AttrHeartbeat()
    if not AB.running or not (Settings.AutoBlock or Settings.AutoBlockCustom) then return end
    if not AB.KillersFolder or not AB.LocalRoot or not AB.LocalRoot.Parent then return end
    for _, k in ipairs(AB.KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr  = k:FindFirstChild("HumanoidRootPart"); if not kr then continue end
            local alu = k:GetAttribute("AbilityLastUsed") or 0
            local au  = k:GetAttribute("AbilitiesUsed")   or 0
            local st  = AB.attrStates[k]
            if st then
                local inc = alu > st.lastAbility
                if au > st.lastUsed then st.isBait = true end
                if inc then
                    if st.isBait then st.isBait = false
                    else
                        local fire = false
                        if Settings.AutoBlockCustom then
                            fire = IsPlayerInCustomZone(k)
                        else
                            local dir = AB.LocalRoot.Position - kr.Position; local mag = dir.Magnitude
                            fire = mag <= 15 and mag > 0 and kr.CFrame.LookVector:Dot(dir.Unit) >= 0.3
                        end
                        if fire then
                            local now = tick()
                            if now - AB.attrDebounce >= 0.15 then
                                AB.attrDebounce = now
                                FireAbilityByMode()
                                if Settings.HDT then task.spawn(function() StartHDT(kr, Settings.HDTDuration) end) end
                            end
                        end
                    end
                end
                st.lastAbility = alu; st.lastUsed = au
            else
                AB.attrStates[k] = {lastAbility=alu, lastUsed=au, isBait=false}
            end
        end
    end
end

