local BLOCK_COOLDOWN = 27
local lastBlockTime = 0
local blockPerKiller = {}
local activeBlocks = {}
local GridVisuals = {}

local BlockConfig = {
    SideRadius = 10,
    FrontRadius = 12,
    Height = 6,
    ShowBox = true,
    Thickness = 0.08,
    Segments = 16,
    WindowDuration = 0.5,
}
local SEG = BlockConfig.Segments
local PARTS_PER_GRID = SEG * 3 + 1

local function getOrCreateGrid(killer)
    local v = GridVisuals[killer]
    if v and v.folder and v.folder.Parent then return v end
    local folder = Instance.new("Folder")
    folder.Name = "Ck_BlockGrid"
    folder.Parent = Workspace
    local parts = {}
    for i = 1, PARTS_PER_GRID do
        local part = Instance.new("Part")
        part.Name = "Ck_GridEdge"
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(255, 60, 60)
        part.Size = Vector3.new(0.08, 0.08, 0.08)
        part.Transparency = 1
        part.Parent = folder
        parts[i] = part
    end
    v = { folder = folder, parts = parts, expiresAt = 0 }
    GridVisuals[killer] = v
    return v
end

local function positionEdge(part, from, to, color, thickness)
    local diff = to - from
    local len = diff.Magnitude
    if len < 0.05 then
        part.Transparency = 1
        return
    end
    part.Size = Vector3.new(thickness, thickness, len)
    part.CFrame = CFrame.lookAt(from + diff * 0.5, to)
    part.Color = color
    part.Transparency = 0
end

local function updateSemiCircle(v, killerCF, sideR, frontR, height, color)
    local pos = killerCF.Position
    local look = killerCF.LookVector
    local lookFlat = Vector3.new(look.X, 0, look.Z)
    if lookFlat.Magnitude < 0.01 then return end
    lookFlat = lookFlat.Unit
    local right = Vector3.new(-lookFlat.Z, 0, lookFlat.X)

    local function arcPoint(angle, y)
        local c, s = math.cos(angle), math.sin(angle)
        return pos + lookFlat * (c * frontR) + right * (s * sideR) + Vector3.new(0, y, 0)
    end

    local angles = {}
    for i = 0, SEG do angles[i + 1] = -math.pi / 2 + (math.pi * i / SEG) end

    local idx = 1
    for i = 1, SEG do
        positionEdge(v.parts[idx], arcPoint(angles[i], 0), arcPoint(angles[i + 1], 0), color, BlockConfig.Thickness)
        idx = idx + 1
    end
    for i = 1, SEG do
        positionEdge(v.parts[idx], arcPoint(angles[i], height), arcPoint(angles[i + 1], height), color, BlockConfig.Thickness)
        idx = idx + 1
    end
    for i = 1, SEG + 1 do
        positionEdge(v.parts[idx], arcPoint(angles[i], 0), arcPoint(angles[i], height), color, BlockConfig.Thickness)
        idx = idx + 1
    end
end

local function hideGrid(v)
    for _, part in ipairs(v.parts) do
        if part and part.Parent then part.Transparency = 1 end
    end
end

local function isInsideSemiCircle(killerCF, targetPos, sideR, frontR, height)
    local killerPos = killerCF.Position
    local look = killerCF.LookVector
    local lookFlat = Vector3.new(look.X, 0, look.Z)
    if lookFlat.Magnitude < 0.01 then return false end
    lookFlat = lookFlat.Unit
    local toTarget = targetPos - killerPos
    local toTargetFlat = Vector3.new(toTarget.X, 0, toTarget.Z)
    local forwardDist = toTargetFlat:Dot(lookFlat)
    if forwardDist <= 0 then return false end
    if math.abs(toTarget.Y) > height * 0.5 then return false end
    local right = Vector3.new(-lookFlat.Z, 0, lookFlat.X)
    local lateralDist = math.abs(toTargetFlat:Dot(right))
    return (lateralDist / sideR) ^ 2 + (forwardDist / frontR) ^ 2 <= 1
end

