local hitboxDraggingTech = false
local _hdtDebounce = false
local HDT_SPEED, HDT_DELAY = 6, 0

local function isHDTBlocked()
    local character = LocalPlayer.Character
    if not character then return true end
    return character:GetAttribute("AbilitiesDisabled") == true
end

local function getNearestKillerModel()
    if not killersFolder then return nil end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, k in ipairs(killersFolder:GetChildren()) do
        if k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < closestDist then closest, closestDist = k, d end
            end
        end
    end
    return closest
end

local function getKillerHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function beginDrag(killerModel)
    if isHDTBlocked() then return end
    if _hdtDebounce then return end
    if not killerModel or not killerModel.Parent then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    local targetHRP = getKillerHRP(killerModel)
    if not targetHRP then return end

    _hdtDebounce = true
    local oldWalk = humanoid.WalkSpeed
    local oldJump = humanoid.JumpPower
    local oldPlatform = humanoid.PlatformStand
    local oldAutoRotate = humanoid.AutoRotate

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.PlatformStand = false
    humanoid.AutoRotate = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.D = 50
    bg.P = 3000
    bg.Parent = hrp

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _hdtDebounce then
            conn:Disconnect()
            if bv and bv.Parent then pcall(function() bv:Destroy() end) end
            if bg and bg.Parent then pcall(function() bg:Destroy() end) end
            humanoid.WalkSpeed = oldWalk
            humanoid.JumpPower = oldJump
            humanoid.PlatformStand = oldPlatform
            humanoid.AutoRotate = oldAutoRotate
            return
        end
        if not (char and char.Parent) or not (killerModel and killerModel.Parent) then
            _hdtDebounce = false; return
        end
        targetHRP = getKillerHRP(killerModel)
        if not targetHRP then _hdtDebounce = false; return end

        local lookTarget = Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z)
        if (lookTarget - hrp.Position).Magnitude > 0.1 then
            bg.CFrame = CFrame.lookAt(hrp.Position, lookTarget)
        end

        local toTarget = targetHRP.Position - hrp.Position
        local dist = toTarget.Magnitude
        local horiz = Vector3.new(toTarget.X, 0, toTarget.Z)
        if horiz.Magnitude > 0.01 then
            local dir = horiz.Unit
            bv.Velocity = Vector3.new(dir.X * HDT_SPEED, bv.Velocity.Y, dir.Z * HDT_SPEED)
        else
            bv.Velocity = Vector3.new(0, bv.Velocity.Y, 0)
        end
        if dist <= 2.0 then _hdtDebounce = false end
    end)

    task.delay(0.4, function() if _hdtDebounce then _hdtDebounce = false end end)
end

local HDT_BLOCK_COOLDOWN = 27
local HDT_ACCEPT_WINDOW  = 0.2

local lastHDTBlockTime     = -math.huge
local lastHDTTriggerAccept = -math.huge

triggerHDTFromBlock = function()
    if isHDTBlocked() then return end
    if not hitboxDraggingTech then return end
    if _hdtDebounce then return end

    local now = os.clock()

    if now - lastHDTTriggerAccept < HDT_ACCEPT_WINDOW then
        return
    end
    if now - lastHDTBlockTime < HDT_BLOCK_COOLDOWN then
        return
    end

    local nearest = getNearestKillerModel()
    if not nearest then return end

    lastHDTTriggerAccept = now

    task.delay(HDT_DELAY, function()
        if isHDTBlocked() then return end
        if not hitboxDraggingTech then return end
        if _hdtDebounce then return end

        local now2 = os.clock()
        if now2 - lastHDTBlockTime < HDT_BLOCK_COOLDOWN then return end

        local currentTarget = getNearestKillerModel()
        if not currentTarget then return end

        lastHDTBlockTime = now2
        beginDrag(currentTarget)
    end)
end

-- ============================================================
-- HDT REMOTE HOOK
-- ============================================================
local hdtHookInstalled = false

local function tryInstallHDTHook()
    if hdtHookInstalled then return true end
    if not (hookmetamethod and getnamecallmethod) then
        print("[c00lsaken] HDT hook unavailable — using fireBlock() fallback.")
        return false
    end

    local ok, err = pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()

            if method == "FireServer" then
                local re = getRemoteNoYield()
                if re and self == re then
                    local args = { ... }
                    if args[1] == "UseActorAbility" and isBlockPayload(args[2]) then
                        if triggerHDTFromBlock then
                            task.spawn(function()
                                triggerHDTFromBlock()
                            end)
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
    end)

    if ok then
        hdtHookInstalled = true
        print("[c00lsaken] HDT remote hook installed.")
        return true
    end

    print("[c00lsaken] HDT remote hook install failed: " .. tostring(err))
    return false
end

task.spawn(function()
    local MAX_ATTEMPTS = 60
    local attempts = 0
    while attempts < MAX_ATTEMPTS do
        if getRemoteNoYield() then
            tryInstallHDTHook()
            return
        end
        attempts = attempts + 1
        task.wait(0.5)
    end
    print("[c00lsaken] HDT hook: remote never appeared after 30s.")
end)

