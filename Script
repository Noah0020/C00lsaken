local LocalCharacter, LocalHumanoid, LocalRoot
local isPunching = false

local function GetClosestKiller(Distance)
    if not killersFolder or not LocalRoot then return nil end
    Distance = Distance or 55
    local SelectedKiller, SelectedDist
    for _, v in ipairs(killersFolder:GetChildren()) do
        if Players:GetPlayerFromCharacter(v) and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChildOfClass("Humanoid") and v:FindFirstChildOfClass("Humanoid").Health > 0 then
            local dist = (v.HumanoidRootPart.Position - LocalRoot.Position).Magnitude
            if dist < Distance then Distance = dist; SelectedKiller = v; SelectedDist = dist end
        end
    end
    return SelectedKiller, SelectedDist
end

local function FirePunch()
    local re = getRemote()
    if not re then return false end

    local payload

    if game.GameId == 6331902150 or game.GameId == 7464167604 then
        payload = {"Punch"}
    else
        payload = "Punch"
    end

    local success = pcall(function()
        re:FireServer("UseActorAbility", payload)
    end)

    return success
end

local punchConnection

local function SetupPunch(character)
    if punchConnection then
        punchConnection:Disconnect()
        punchConnection = nil
    end

    LocalCharacter = character

    task.spawn(function()
        local humanoid, root

        while character.Parent do
            humanoid = character:FindFirstChildOfClass("Humanoid")
            root = character:FindFirstChild("HumanoidRootPart")
            if humanoid and root then break end
            task.wait(0.2)
        end

        if not humanoid or not root or not character.Parent then return end

        LocalHumanoid = humanoid
        LocalRoot = root

        if punchConnection then
            punchConnection:Disconnect()
            punchConnection = nil
        end

        punchConnection = character:GetAttributeChangedSignal("TimesHit"):Connect(function()
            if not CONFIG.AutoPunch or isPunching then return end

            local speedMult = character:FindFirstChild("SpeedMultipliers")
            local fovMult = character:FindFirstChild("FOVMultipliers")

            if not speedMult
                or not speedMult:FindFirstChild("GuestBlocking")
                or (LocalHumanoid:GetAttribute("Overheal") or 0) < 10 then
                return
            end

            if not GetClosestKiller() then return end

            isPunching = true

            task.spawn(function()
                local cameraConnection
                local success, err = pcall(function()
                    task.wait(0.08)

                    if not character.Parent or not LocalRoot.Parent then return end

                    character:SetAttribute("DisableShiftLockMovement", true)
                    FirePunch()

                    local timeout = Workspace.DistributedGameTime + 1.25
                    local selectedVelocity

                    cameraConnection = RunService.RenderStepped:Connect(function()
                        local killer = GetClosestKiller()

                        if not killer or not killer:FindFirstChild("HumanoidRootPart") then
                            return
                        end

                        local killerPos = killer.HumanoidRootPart.Position
                        local selectedPosition = Vector3.new(
                            killerPos.X,
                            LocalRoot.Position.Y,
                            killerPos.Z
                        )

                        local targetCFrame = CFrame.new(
                            LocalRoot.Position,
                            selectedPosition
                        )

                        LocalRoot.CFrame = targetCFrame

                        if not selectedVelocity then
                            selectedVelocity = targetCFrame.LookVector * 32
                        else
                            selectedVelocity = LocalRoot.Velocity:Lerp(
                                selectedVelocity,
                                CONFIG.AutoPunchAccuracy / 100
                            )
                        end

                        LocalRoot.Velocity = selectedVelocity
                    end)

                    repeat
                        task.wait(0.1)
                    until
                        (fovMult and fovMult:FindFirstChild("HitRegistered"))
                        or (speedMult and not speedMult:FindFirstChild("PunchAbility"))
                        or Workspace.DistributedGameTime > timeout
                        or not CONFIG.AutoPunch
                        or not character.Parent
                end)

                if cameraConnection then
                    cameraConnection:Disconnect()
                end

                if character and character.Parent then
                    pcall(function()
                        character:SetAttribute("DisableShiftLockMovement", false)
                    end)
                end

                isPunching = false

                if not success then
                    warn("[c00lsaken] Auto Punch error:", err)
                end
            end)
        end)
    end)
end

if LocalPlayer.Character then SetupPunch(LocalPlayer.Character) end
