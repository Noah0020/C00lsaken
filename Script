local Rectangle = { folder=nil, boxes={}, loop=nil }
local RECT_THICK = 0.1

local function EnsureRectFolder()
    if not Rectangle.folder or not Rectangle.folder.Parent then
        local f = Instance.new("Folder")
        f.Name = "BoxVisuals"
        f.Parent = Workspace
        Rectangle.folder = f
    end
end

local function BuildBoxEdges(box, cf, size)
    if not box or not box.model or not box.model.Parent then return end
    local L, W, H = size.Z, size.X, size.Y
    local c = {
        Vector3.new(-W/2,-H/2,-L/2), Vector3.new(W/2,-H/2,-L/2),
        Vector3.new(W/2,-H/2,L/2), Vector3.new(-W/2,-H/2,L/2),
        Vector3.new(-W/2,H/2,-L/2), Vector3.new(W/2,H/2,-L/2),
        Vector3.new(W/2,H/2,L/2), Vector3.new(-W/2,H/2,L/2),
    }
    local prs = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8} }
    for i, pr in ipairs(prs) do
        local e = box.edges[i]
        if e and e.Parent then
            local p1 = cf:PointToWorldSpace(c[pr[1]])
            local p2 = cf:PointToWorldSpace(c[pr[2]])
            local mid = (p1+p2)/2
            local diff = p2-p1
            local len = diff.Magnitude
            if len > 0.01 then
                local dir = diff.Unit
                local up = Vector3.new(0,1,0)
                if math.abs(dir.Y) > 0.95 then up = Vector3.new(0,0,1) end
                local rgt = dir:Cross(up)
                if rgt.Magnitude < 0.01 then rgt = Vector3.new(1,0,0) end
                rgt = rgt.Unit
                local uf = rgt:Cross(dir).Unit
                e.Size = Vector3.new(RECT_THICK, RECT_THICK, len)
                e.CFrame = CFrame.fromMatrix(mid, rgt, uf, dir)
            end
        end
    end
end

local function CreateBox(k)
    if not k or not k.Parent then return nil end
    local kr = k:FindFirstChild("HumanoidRootPart")
    if not kr then return nil end
    EnsureRectFolder()
    local m = Instance.new("Model")
    m.Name = "Box"
    m.Parent = Rectangle.folder
    local edges = {}
    for i = 1, 12 do
        local e = Instance.new("Part")
        e.Name = "Edge"..i
        e.Anchored = true
        e.CanCollide = false
        e.CanQuery = false
        e.CanTouch = false
        e.CastShadow = false
        e.Material = Enum.Material.Neon
        e.Color = Color3.fromRGB(175, 150, 220)
        e.Transparency = 0.2
        e.Size = Vector3.new(RECT_THICK, RECT_THICK, 1)
        e.CFrame = CFrame.new(0, -5000, 0)
        e.Parent = m
        edges[i] = e
    end
    local box = { model=m, edges=edges, killer=k }
    BuildBoxEdges(box, CalcRectCF(kr), GetRectSize())
    return box
end

local function DestroyBox(b)
    if b and b.model and b.model.Parent then pcall(function() b.model:Destroy() end) end
end

local function ClearBoxes()
    for _, b in ipairs(Rectangle.boxes) do DestroyBox(b) end
    Rectangle.boxes = {}
end

local function EnsureBoxLoop()
    if Rectangle.loop then return end
    Rectangle.loop = RunService.RenderStepped:Connect(function()
        if not State.ShowBox then
            if #Rectangle.boxes > 0 then ClearBoxes() end
            return
        end
        local seen = {}
        if KillersFolder then
            for _, k in ipairs(KillersFolder:GetChildren()) do
                if k:IsA("Model") and k.Parent then
                    seen[k] = true
                    local kr = k:FindFirstChild("HumanoidRootPart")
                    if kr then
                        local box = nil
                        for _, b in ipairs(Rectangle.boxes) do if b.killer == k then box = b; break end end
                        if not box then
                            box = CreateBox(k)
                            if box then table.insert(Rectangle.boxes, box) end
                        else
                            BuildBoxEdges(box, CalcRectCF(kr), GetRectSize())
                        end
                        local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                        local inside = State.AutoBlockShape == "Box" and myRoot and InBoxRange(kr, myRoot.Position)
                        for _, edge in ipairs(box.edges) do
                            if edge and edge.Parent then
                                edge.Color = inside and C.Green or Color3.fromRGB(175, 150, 220)
                            end
                        end
                    end
                end
            end
        end
        for i = #Rectangle.boxes, 1, -1 do
            local b = Rectangle.boxes[i]
            if not b.killer or not b.killer.Parent or not seen[b.killer] then
                DestroyBox(b)
                table.remove(Rectangle.boxes, i)
            end
        end
    end)
end

local function StopBoxLoop()
    if Rectangle.loop then pcall(function() Rectangle.loop:Disconnect() end); Rectangle.loop = nil end
    ClearBoxes()
end

-- ============ CONE VISUAL ============
local Cone = { folder=nil, zones={}, loop=nil }

local function GetFlatLook(kr)
    local lv = kr.CFrame.LookVector
    local f = Vector3.new(lv.X, 0, lv.Z)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local p = Vector3.new(kr.Position.X, kr.Position.Y - 3, kr.Position.Z)
    return CFrame.lookAt(p, p + f)
end

local function BuildConeZone(k)
    local m = Instance.new("Model")
    m.Name = "Cone_"..k.Name
    m.Parent = Cone.folder
    local edges = {}
    for i = 1, 4 do
        local p = Instance.new("Part")
        p.Name = "Edge"..i
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.Neon
        p.Color = Color3.fromRGB(255, 60, 60)
        p.Transparency = 0.6
        p.Size = Vector3.new(0.35, 0.08, 1)
        p.CFrame = CFrame.new(0, -5000, 0)
        p.Parent = m
        edges[i] = p
    end
    return { model=m, edges=edges, killer=k }
end

local function UpdateConeZone(z, kr)
    if not z or not z.model or not z.model.Parent or not kr then return end
    local dCF = GetFlatLook(kr)
    local L = State.ConeLength
    local W = State.ConeWidth
    local wA = dCF:PointToWorldSpace(Vector3.new(0, 0, 0))
    local wB = dCF:PointToWorldSpace(Vector3.new(0, 0, -L))
    local wC = dCF:PointToWorldSpace(Vector3.new(-W/2, 0, -L/2))
    local wD = dCF:PointToWorldSpace(Vector3.new(W/2, 0, -L/2))
    local specs = { {wA,wC}, {wA,wD}, {wB,wC}, {wB,wD} }
    for i, sp in ipairs(specs) do
        local p1, p2 = sp[1], sp[2]
        local mid = (p1+p2)/2
        local diff = p2-p1
        local len = diff.Magnitude
        if len > 0.01 then
            local e = z.edges[i]
            if e and e.Parent then
                e.Size = Vector3.new(0.35, 0.08, len)
                e.CFrame = CFrame.lookAt(mid, mid + diff.Unit)
                e.Transparency = State.ShowCone and 0.6 or 1
            end
        end
    end
end

local function EnsureConeLoop()
    if Cone.loop then return end
    if not Cone.folder or not Cone.folder.Parent then
        local f = Instance.new("Folder")
        f.Name = "ConeVisuals"
        f.Parent = Workspace
        Cone.folder = f
    end
    Cone.loop = RunService.RenderStepped:Connect(function()
        if not State.ShowCone then
            for k, z in pairs(Cone.zones) do
                if z.model then z.model:Destroy() end
            end
            Cone.zones = {}
            return
        end
        if not KillersFolder then return end
        local seen = {}
        for _, k in ipairs(KillersFolder:GetChildren()) do
            if k:IsA("Model") then
                seen[k] = true
                local kr = k:FindFirstChild("HumanoidRootPart")
                if kr then
                    local z = Cone.zones[k]
                    if not z or not z.model or not z.model.Parent then
                        if z and z.model then pcall(function() z.model:Destroy() end) end
                        z = BuildConeZone(k)
                        Cone.zones[k] = z
                    end
                    UpdateConeZone(z, kr)
                    local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                    local inside = State.AutoBlockShape == "Cone" and myRoot and InConeRange(kr, myRoot.Position)
                    for _, edge in ipairs(z.edges) do
                        if edge and edge.Parent then
                            edge.Color = inside and C.Green or Color3.fromRGB(255, 60, 60)
                        end
                    end
                end
            end
        end
        for k, z in pairs(Cone.zones) do
            if not seen[k] then
                if z.model then pcall(function() z.model:Destroy() end) end
                Cone.zones[k] = nil
            end
        end
    end)
end

local function StopConeLoop()
    if Cone.loop then pcall(function() Cone.loop:Disconnect() end); Cone.loop = nil end
    for _, z in pairs(Cone.zones) do if z.model then pcall(function() z.model:Destroy() end) end end
    Cone.zones = {}
end

