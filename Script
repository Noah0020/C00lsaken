-- BACKSTAB
-- ============================================================
local BS_CFG = {
    Enabled        = false,
    BehindOffset   = 2,
    MaxRange       = 60,
    Cooldown       = 0.5,
    TeleportDelay  = 0.02,
    FollowDuration = 0.5,
}

local BS_lastStab        = 0
local BS_stabbing        = false
local BS_lerpConn        = nil
local BS_originalAutoRot = true

local BS_DAGGER_ANIM_IDS = {
    ["100725497418533"] = true,
    ["89448354637442"]  = true,
}

local function bsGetKillerFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function bsGetKHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function bsGetMyHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function bsGetMyHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function bsGetKiller()
    local f = bsGetKillerFolder()
    if not f then return nil, nil end
    for _, k in ipairs(f:GetChildren()) do
        if k:IsA("Model") then
            local h = bsGetKHRP(k)
            local hum = k:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                return k, h
            end
        end
    end
    return nil, nil
end

local function bsIsDagger(track)
    local a = track and track.Animation
    if not a then return false end
    local n = tostring(a.AnimationId):match("%d+")
    return n and BS_DAGGER_ANIM_IDS[n] == true
end

local function bsStopLerp()
    if BS_lerpConn then
        pcall(function() BS_lerpConn:Disconnect() end)
        BS_lerpConn = nil
    end
    local hum = bsGetMyHum()
    if hum then hum.AutoRotate = BS_originalAutoRot end
    BS_stabbing = false
end

local function bsFollowBehind(killerModel)
    if BS_lerpConn then
        pcall(function() BS_lerpConn:Disconnect() end)
        BS_lerpConn = nil
    end

    local myHum = bsGetMyHum()
    BS_originalAutoRot = myHum and myHum.AutoRotate or true
    if myHum then myHum.AutoRotate = false end

    local endTime = os.clock() + BS_CFG.FollowDuration

    BS_lerpConn = RunService.RenderStepped:Connect(function()
        if os.clock() >= endTime or not BS_stabbing then
            bsStopLerp()
            return
        end

        local h = bsGetMyHRP()
        if not h then bsStopLerp(); return end

        local kHRP = killerModel and bsGetKHRP(killerModel)
        if not kHRP or not kHRP.Parent then bsStopLerp(); return end

        local kCF = kHRP.CFrame
        local behindPos = kCF.Position - kCF.LookVector * BS_CFG.BehindOffset
        local targetCF = CFrame.lookAt(
            Vector3.new(behindPos.X, h.Position.Y, behindPos.Z),
            Vector3.new(kCF.Position.X, h.Position.Y, kCF.Position.Z)
        )

        h.CFrame = h.CFrame:Lerp(targetCF, 0.5)
        h.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function bsHunterStab()
    if not BS_CFG.Enabled then return end
    if BS_stabbing then return end
    if os.clock() - BS_lastStab < BS_CFG.Cooldown then return end

    local myHRP = bsGetMyHRP()
    if not myHRP then return end

    local killer, kHRP = bsGetKiller()
    if not killer or not kHRP then return end

    local dist = (kHRP.Position - myHRP.Position).Magnitude
    if dist > BS_CFG.MaxRange then return end

    BS_stabbing = true
    BS_lastStab = os.clock()

    local kCF = kHRP.CFrame
    local behindPos = kCF.Position - kCF.LookVector * BS_CFG.BehindOffset
    local origin = myHRP.CFrame
    local behind = CFrame.lookAt(
        Vector3.new(behindPos.X, origin.Position.Y, behindPos.Z),
        Vector3.new(kCF.Position.X, origin.Position.Y, kCF.Position.Z)
    )

    task.wait(BS_CFG.TeleportDelay)

    local now = bsGetMyHRP()
    if not now then BS_stabbing = false return end
    now.CFrame = behind
    now.AssemblyLinearVelocity = Vector3.zero

    bsFollowBehind(killer)
end

_G.C00lsakenBackstab = bsHunterStab

local bsHookedAnims = setmetatable({}, {__mode = "k"})

local function bsHookAnimator(anim)
    if not anim or not anim:IsA("Animator") then return end
    if bsHookedAnims[anim] then return end
    bsHookedAnims[anim] = true

    anim.AnimationPlayed:Connect(function(t)
        if not t or not bsIsDagger(t) then return end
        bsHunterStab()
    end)
end

local function bsBindCharacter(character)
    if not character then return end

    local humanoidBound = false

    local function tryBindHumanoid()
        if humanoidBound then return true end
        local hum = character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        humanoidBound = true

        local anim = hum:FindFirstChildOfClass("Animator")
        if anim then bsHookAnimator(anim) end

        hum.ChildAdded:Connect(function(child)
            if child:IsA("Animator") then
                bsHookAnimator(child)
            end
        end)

        return true
    end

    if tryBindHumanoid() then return end

    local humanoidConn
    humanoidConn = character.ChildAdded:Connect(function(child)
        if child:IsA("Humanoid") then
            if tryBindHumanoid() then
                if humanoidConn then humanoidConn:Disconnect(); humanoidConn = nil end
            end
        end
    end)

    task.spawn(function()
        while character.Parent do
            if tryBindHumanoid() then
                if humanoidConn then humanoidConn:Disconnect(); humanoidConn = nil end
                return
            end
            task.wait(0.2)
        end
        if humanoidConn then humanoidConn:Disconnect(); humanoidConn = nil end
    end)
end

if LocalPlayer.Character then bsBindCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c)
    bsStopLerp()
    bsBindCharacter(c)
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.H then
        bsHunterStab()
    end
end)

