-- ============================================================
-- PAYLOAD DETECTION
-- ============================================================
local function isBlockPayload(payload)
    if type(payload) == "string" then
        return payload == "Block" or payload:find("Block") ~= nil
    elseif typeof(payload) == "buffer" then
        local ok, s = pcall(function() return buffer.tostring(payload) end)
        return ok and s and s:find("Block") ~= nil
    elseif type(payload) == "table" then
        for _, v in pairs(payload) do
            if isBlockPayload(v) then return true end
        end
    end
    return false
end

