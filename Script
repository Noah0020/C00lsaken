local _remote = nil

local function getRemote()
    if _remote and _remote.Parent then return _remote end
    local ok, re = pcall(function()
        return ReplicatedStorage:WaitForChild("Modules", 10):WaitForChild("Network", 5):WaitForChild("Network", 5):WaitForChild("RemoteEvent", 5)
    end)
    if ok and re then _remote = re; return re end
    return nil
end

local function getRemoteNoYield()
    if _remote and _remote.Parent then return _remote end
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    if not mods then return nil end
    local net1 = mods:FindFirstChild("Network")
    if not net1 then return nil end
    local net2 = net1:FindFirstChild("Network")
    if not net2 then return nil end
    local re = net2:FindFirstChild("RemoteEvent")
    if re then _remote = re; return re end
    return nil
end

