-- Facing check — ALWAYS ACTIVE, no toggle needed
local function IsFacing(localRoot, killerRoot)
    if not localRoot or not killerRoot then return false end
    local dx = localRoot.Position.X - killerRoot.Position.X
    local dz = localRoot.Position.Z - killerRoot.Position.Z
    local mag = math.sqrt(dx*dx + dz*dz)
    if mag < 0.01 then return true end
    local ux, uz = dx/mag, dz/mag
    local lv = killerRoot.CFrame.LookVector
    local lx, lz = lv.X, lv.Z
    local lmag = math.sqrt(lx*lx + lz*lz)
    if lmag < 0.01 then return true end
    lx, lz = lx/lmag, lz/lmag
    return (lx*ux + lz*uz) > (State.FacingCheckThreshold or 0.3)
end

local function HasWallBetween(fromPos, toPos, excludeModel)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filters = {Player.Character}
    if excludeModel then table.insert(filters, excludeModel) end
    params.FilterDescendantsInstances = filters
    params.IgnoreWater = true
    local dir = toPos - fromPos
    if dir.Magnitude < 1 then return false end
    return Workspace:Raycast(fromPos, dir.Unit * (dir.Magnitude - 1), params) ~= nil
end

local function GetNearestKiller()
    if not KillersFolder or not Player.Character then return nil, nil end
    local myRoot = Player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil end
    local best, bd, bestRoot = nil, math.huge, nil
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local d = (kr.Position - myRoot.Position).Magnitude
                if d < bd then best, bd, bestRoot = k, d, kr end
            end
        end
    end
    return bestRoot, best
end

-- Box / Cone CF (ALWAYS in front of killer, no offset)
local function CalcRectCF(kr)
    local p = kr.Position
    local lv = kr.CFrame.LookVector
    local f = Vector3.new(lv.X, 0, lv.Z)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    local facing = CFrame.lookAt(p, p + f)
    -- The box begins at the killer and extends forward, matching the cone.
    return facing * CFrame.new(0, 0, -State.BoxLength / 2)
end

local function GetRectSize()
    return Vector3.new(State.BoxWidth, State.BoxHeight, State.BoxLength)
end

