    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        if not track or not track.Animation then return end
        local id = tostring(track.Animation.AnimationId or ""):gsub("%D", "")
        if id == TARGET_ANIMATION_ID and stabEnabledBackstab then task.spawn(runBackstab)
        elseif id == DASHSTAB_ANIM_ID and stabEnabledDashstab then task.spawn(runDashstab) end
    end)
end
