local MusicDir = "CupcakeHubMusic"
local MusicState = { on=false, cached={}, origId=nil, thread=nil, dirOk=false }
if CanUseFS then
    MusicState.dirOk = pcall(function()
        if not isfolder(MusicDir) then makefolder(MusicDir) end
    end)
end
local function Music_Fetch(name)
    if not CanUseFS or not MusicState.dirOk then return nil end
    if MusicState.cached[name] then return MusicState.cached[name] end
    local url = MusicTracks[name]; if not url then return nil end
    local p = MusicDir .. "/" .. name .. ".mp3"
    if not isfile(p) then
        local ok, data = pcall(function() return game:HttpGet(url) end)
        if not ok or not data then return nil end
        if not pcall(writefile, p, data) then return nil end
    end
    local ok, asset = pcall(getcustomasset, p)
    if ok and asset then MusicState.cached[name] = asset; return asset end
end
local function Music_GetSound()
    return (Workspace:FindFirstChild("Themes") and Workspace.Themes:FindFirstChild("LastSurvivor"))
        or Workspace:FindFirstChild("LastSurvivor", true)
end
local function Music_Apply(name)
    pcall(function()
        local s = Music_GetSound(); if not s then return end
        if not MusicState.origId then MusicState.origId = s.SoundId end
        local a = Music_Fetch(name); if not a then return end
        if s.SoundId ~= a then s.SoundId = a; s:Stop(); task.wait(0.05); s:Play()
        elseif not s.IsPlaying then s:Play() end
    end)
end
local function Music_Reset()
    pcall(function()
        local s = Music_GetSound()
        if s and MusicState.origId then s.SoundId = MusicState.origId; s:Stop(); task.wait(0.05); s:Play() end
    end)
end
local function Music_Monitor()
    while MusicState.on do
        pcall(function()
            local s = Music_GetSound()
            if s then
                local a = MusicState.cached[Settings.MUSIC_Track]
                if a then
                    if s.SoundId ~= a then
                        if not MusicState.origId then MusicState.origId = s.SoundId end
                        s.SoundId = a; s:Stop(); task.wait(0.05); s:Play()
                    elseif not s.IsPlaying then s:Play() end
                else task.spawn(function() Music_Fetch(Settings.MUSIC_Track); Music_Apply(Settings.MUSIC_Track) end) end
            end
        end)
        task.wait(1)
    end
end
local function Music_SetActive(on)
    MusicState.on = on; Settings.MUSIC_Active = on
    if on then
        task.spawn(function() Music_Fetch(Settings.MUSIC_Track); Music_Apply(Settings.MUSIC_Track) end)
        MusicState.thread = task.spawn(Music_Monitor)
    else
        if MusicState.thread then pcall(task.cancel, MusicState.thread); MusicState.thread = nil end
        Music_Reset()
    end
end

