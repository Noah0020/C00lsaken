-- Auto Studs
local bsLastKillerModel = nil
local bsLastKillerPos   = nil
local bsSmoothedSpeed   = 0

RunService.Heartbeat:Connect(function(dt)
    if not BS_CFG.AutoStuds then
        bsLastKillerModel = nil
        bsSmoothedSpeed   = 0
        return
    end

    local killer = bsGetFirstValidKiller()
    if not killer then
        bsLastKillerModel = nil
        bsSmoothedSpeed   = 0
        return
    end

    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp then
        bsLastKillerModel = nil
        return
    end

    local currentPos = khrp.Position
    local rawSpeed   = 0

    if bsLastKillerModel == killer and bsLastKillerPos then
        local d = Vector3.new(currentPos.X, 0, currentPos.Z)
                - Vector3.new(bsLastKillerPos.X, 0, bsLastKillerPos.Z)
        rawSpeed = d.Magnitude / dt
    end

    bsLastKillerModel = killer
    bsLastKillerPos   = currentPos

    bsSmoothedSpeed = bsSmoothedSpeed + (rawSpeed - bsSmoothedSpeed) * math.min(dt * 15, 1)
    local finalSpeed = math.clamp(bsSmoothedSpeed, 0, 30)

    local studsAtRun = BS_CFG.RunStuds
    if BS_CFG.DetectPing then
        local ping = bsGetPing()
        local clampedPing = math.max(ping, 20)
        studsAtRun = BS_CFG.RunStuds - ((clampedPing - 20) / 100) * 1.5
        studsAtRun = math.max(studsAtRun, 1.0)
    end

    local slope = (BS_CFG.StandStuds - studsAtRun) / 26.0
    BS_CFG.BehindStuds = BS_CFG.StandStuds - (finalSpeed * slope)
end)

