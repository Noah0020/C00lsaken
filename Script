local MinigameSolver = { Enabled = false, ManualEnabled = false, Generation = 0, LockBoard = nil, Installed = false }
local function req(parent, ...)
    local ok, mod = pcall(function()
        local cur = parent
        for i = 1, select("#", ...) do
            if not cur then return nil end
            cur = cur:FindFirstChild((select(i, ...)))
        end
        return cur and require(cur)
    end)
    return ok and mod or nil
end
local MinigameFolder = ReplicatedStorage:FindFirstChild("Systems")
    and ReplicatedStorage.Systems:FindFirstChild("Player")
    and ReplicatedStorage.Systems.Player:FindFirstChild("Game")
    and ReplicatedStorage.Systems.Player.Game:FindFirstChild("Minigames")
local FlowBoardModule    = req(ReplicatedStorage, "Modules", "Minigames", "FlowBoard")
local LockBoardModule    = req(ReplicatedStorage, "Modules", "Minigames", "LockBoard")
local FlowInputModule    = MinigameFolder and MinigameFolder:FindFirstChild("FlowClientMinigame")
    and MinigameFolder.FlowClientMinigame:FindFirstChild("FlowInput")
    and req(MinigameFolder.FlowClientMinigame.FlowInput)
local GearInputModule    = MinigameFolder and MinigameFolder:FindFirstChild("GearClientMinigame")
    and MinigameFolder.GearClientMinigame:FindFirstChild("GearInput")
    and req(MinigameFolder.GearClientMinigame.GearInput)
local LockInputModule    = MinigameFolder and MinigameFolder:FindFirstChild("LockClientMinigame")
    and MinigameFolder.LockClientMinigame:FindFirstChild("LockInput")
    and req(MinigameFolder.LockClientMinigame.LockInput)
local ConnectInputModule = MinigameFolder and MinigameFolder:FindFirstChild("ConnectClientMinigame")
