local HDT = { enabled=false, speed=9, delay=0.05, duration=0.6, debounce=false, lastDamage=0,
    WC=nil, CH=nil, RT=nil, CA=nil, BIND="HDT_Bind" }
local HDT_ANIMS = { ["72722244508749"]=true, ["96959123077498"]=true, ["95802026624883"]=true, ["140671644163156"]=true, ["100926346851492"]=true }

local function HDT_NearestKiller()
    if not KillersFolder or not Player.Character then return nil end
    local myRoot = Player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local d = (kr.Position - myRoot.Position).Magnitude
                if d < bd then best, bd = k, d end
            end
        end
    end
    return best
end

local function HDT_Dash(km)
    if HDT.debounce or not km or not km.Parent then return end
    local c = Player.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    local kr = km:FindFirstChild("HumanoidRootPart") or km.PrimaryPart
    if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true
    local oWS, oAR = h.WalkSpeed, h.AutoRotate
    h.WalkSpeed = HDT.speed
    h.AutoRotate = true
    local st = tick()
    pcall(function() RunService:UnbindFromRenderStep(HDT.BIND) end)
    RunService:BindToRenderStep(HDT.BIND, Enum.RenderPriority.Last.Value + 1, function()
        if not HDT.debounce then pcall(function() RunService:UnbindFromRenderStep(HDT.BIND) end); return end
        if not c.Parent or not km.Parent or not h.Parent then HDT.debounce = false; return end
        local t = km:FindFirstChild("HumanoidRootPart")
        if not t then HDT.debounce = false; return end
        local flat = Vector3.new(t.Position.X - hrp.Position.X, 0, t.Position.Z - hrp.Position.Z)
        if flat.Magnitude <= 2 then HDT.debounce = false; return end
        h.WalkSpeed = HDT.speed
        h:Move(flat.Unit, false)
        if tick() - st > HDT.duration then HDT.debounce = false end
    end)
    local hb
    hb = RunService.Heartbeat:Connect(function()
        if not HDT.debounce then if hb then hb:Disconnect() end; return end
        if h and h.Parent then h.WalkSpeed = HDT.speed end
    end)
    task.delay(HDT.duration + 0.2, function() if HDT.debounce then HDT.debounce = false end end)
    task.spawn(function()
        while HDT.debounce do task.wait() end
        pcall(function() RunService:UnbindFromRenderStep(HDT.BIND) end)
        if hb and hb.Connected then hb:Disconnect() end
        if h and h.Parent then pcall(function() h:Move(Vector3.new(0,0,0), false); h.WalkSpeed = oWS; h.AutoRotate = oAR end) end
    end)
end

local function HDT_OnAnim(track)
    if not HDT.enabled or HDT.debounce then return end
    if tick() - HDT.lastDamage < 0.2 then return end
    local id
    pcall(function() id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+") end)
    if not id or not HDT_ANIMS[id] then return end
    local k = HDT_NearestKiller()
    if not k then return end
    if HDT.delay > 0 then
        task.delay(HDT.delay, function() if HDT.enabled and not HDT.debounce then HDT_Dash(k) end end)
    else
        HDT_Dash(k)
    end
end

local function HDT_TryAttach()
    local c = Player.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    local an = h:FindFirstChildOfClass("Animator")
    if not an then return end
    if HDT.CA == an and HDT.WC then return end
    if HDT.WC then pcall(function() HDT.WC:Disconnect() end); HDT.WC = nil end
    HDT.CA = an
    HDT.WC = an.AnimationPlayed:Connect(HDT_OnAnim)
end

local function HDT_Start()
    HDT.enabled = true
    HDT_TryAttach()
    if not HDT.CH then HDT.CH = Player.CharacterAdded:Connect(function() task.wait(0.5); if HDT.enabled then HDT_TryAttach() end end) end
    if not HDT.RT then
        HDT.RT = task.spawn(function()
            while HDT.enabled do
                if not HDT.WC then HDT_TryAttach() end
                task.wait(1)
            end
            HDT.RT = nil
        end)
    end
end
local function HDT_Stop()
    HDT.enabled = false
    if HDT.WC then pcall(function() HDT.WC:Disconnect() end); HDT.WC = nil end
    if HDT.CH then pcall(function() HDT.CH:Disconnect() end); HDT.CH = nil end
    if HDT.RT then pcall(task.cancel, HDT.RT); HDT.RT = nil end
    HDT.CA = nil
    HDT.debounce = false
    pcall(function() RunService:UnbindFromRenderStep(HDT.BIND) end)
end

