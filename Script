local animationSpeed = 5

RunService.RenderStepped:Connect(function()
    if not Gui.Parent then return end
    if not isOpen then return end

    if Scanline.Visible then
        local y = (os.clock() * animationSpeed * 0.08) % 1
        Scanline.Position = UDim2.new(0, 0, y, 0)
    end

    local pulse = (math.sin(os.clock() * animationSpeed) + 1) / 2
    if MainStroke.Enabled then
        MainStroke.Color = C.Yellow:Lerp(C.Cyan, pulse * 0.35)
    end
end)

