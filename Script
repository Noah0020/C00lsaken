RunService.RenderStepped:Connect(function()
    if not AutoBlockEnabled then
        for _, v in pairs(GridVisuals) do hideGrid(v) end
        return
    end
    local char = LP.Character
    if not char then return end
    local playerHRP = char:FindFirstChild("HumanoidRootPart")
    if not playerHRP then return end
    local now = os.clock()

    local expired = {}
    for killer, expiresAt in pairs(activeBlocks) do
        if now > expiresAt or not killer.Parent then table.insert(expired, killer) end
    end
    for _, killer in ipairs(expired) do activeBlocks[killer] = nil end

    for killer, _ in pairs(activeBlocks) do
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if hrp then
            local sideR = BlockConfig.SideRadius
            local frontR = BlockConfig.FrontRadius
            local height = BlockConfig.Height
            local overlapping = isInsideSemiCircle(hrp.CFrame, playerHRP.Position, sideR, frontR, height)
            if BlockConfig.ShowBox then
                local v = getOrCreateGrid(killer)
                local color = overlapping and Color3.fromRGB(80, 255, 80) or Color3.fromRGB(255, 60, 60)
                updateSemiCircle(v, hrp.CFrame, sideR, frontR, height, color)
                v.expiresAt = now + 0.1
            end
            if overlapping then fireBlock(killer) end
        end
    end

    for killer, v in pairs(GridVisuals) do
        if now > v.expiresAt + 0.1 then hideGrid(v) end
    end
end)

