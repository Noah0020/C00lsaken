local function nearest(kind)
    local folder = PlayersFolder and PlayersFolder:FindFirstChild(kind)
    if not folder or not LocalCharacter then return nil end
    local hrp = LocalCharacter:FindFirstChild("HumanoidRootPart"); if not hrp then return nil end
    local best, bd = nil, Settings.AIM_Distance
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and m ~= LocalCharacter and m:FindFirstChild("HumanoidRootPart") then
            local d = (m.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < bd then bd = d; best = m end
        end
    end
    return best
end
