    local d = makeLabel(card, "Tap to cycle", 12, C.Grey)
    d.Position = UDim2.fromOffset(14, 41)
    d.Size = UDim2.new(1, -120, 0, 26)

    local btn = makeButton(card, getValue(), UDim2.fromOffset(120, 32), UDim2.new(1, -134, 0.5, -16))
    btn.BackgroundColor3 = C.Panel2
    btn.TextColor3 = C.Yellow
    btn.TextSize = 14

    btn.Activated:Connect(function()
        local cur = getValue()
        local idx = 1
        for i, opt in ipairs(options) do
            if opt == cur then idx = i; break end
        end
        idx = idx + 1
        if idx > #options then idx = 1 end
        local newVal = options[idx]
        setValue(newVal)
        btn.Text = newVal
    end)

    return btn
end

