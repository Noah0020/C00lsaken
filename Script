local function makeBuffer(bytes)
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
    return b
end

-- Fire abilities via real buffer-encoded remotes (confirmed from meowsaken)
local function FireAbility(name)
    if name == "Block" then
        -- bytes: "Block"
        Remote:FireServer("UseActorAbility", {makeBuffer({3,5,0,0,0,66,108,111,99,107})})
    elseif name == "Clone" then
        -- bytes: "Clone"
        Remote:FireServer("UseActorAbility", {makeBuffer({3,5,0,0,0,67,108,111,110,101})})
    elseif name == "Punch" then
        Remote:FireServer("UseActorAbility", {buffer.fromstring("\003\005\000\000\000Punch")})
    end
end

local function FireAbilityByMode()
    local mode = Settings.AutoBlockCustom and Settings.CustomABMode or Settings.ABMode
    if mode == "007n7" then FireAbility("Clone") else FireAbility("Block") end
end

