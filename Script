local hdtHookInstalled = false

local function tryInstallHDTHook()
    if hdtHookInstalled then return true end
    if not (hookmetamethod and getnamecallmethod) then return false end

    local ok = pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local re = getRemoteNoYield()
                if re and self == re then
                    local args = { ... }
                    if args[1] == "UseActorAbility" and isBlockPayload(args[2]) then
                        if triggerHDTFromBlock then
                            task.spawn(function() triggerHDTFromBlock() end)
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
    end)

    if ok then
        hdtHookInstalled = true
        print("[c00lsaken] HDT remote hook installed.")
        return true
    end
    return false
end

task.spawn(function()
    local attempts = 0
    while attempts < 60 do
        if getRemoteNoYield() then
            tryInstallHDTHook()
            return
        end
        attempts = attempts + 1
        task.wait(0.5)
    end
end)

