-- STAMINA
--═══════════════════════════════════════════════════════════════════
local Stam = { running=false, thread=nil, saved=nil, mod=nil }

local function Stam_GetMod()
    local ok, m = pcall(function() return require(ReplicatedStorage.Systems.Character.Game.Sprinting) end)
    if ok and m then return m end
    ok, m = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting"))
    end)
    return ok and m or nil
end

local function Stam_Enable()
    if Stam.running then return end
    Stam.running = true
    Stam.thread = task.spawn(function()
        local mod = Stam_GetMod(); if not mod then Stam.running = false; return end
        Stam.mod = mod
        Stam.saved = { MaxStamina=mod.MaxStamina, StaminaDrain=mod.StaminaDrain, StaminaGain=mod.StaminaGain, Stamina=mod.Stamina }
        while Stam.running do
            task.wait(0.01)
            pcall(function()
                if mod.MaxStamina   then mod.MaxStamina   = math.max(mod.MaxStamina, 1000) end
                if mod.Stamina      then mod.Stamina      = mod.MaxStamina or 1000 end
                if mod.StaminaDrain then mod.StaminaDrain = 0 end
            end)
        end
    end)
end

local function Stam_Disable()
    Stam.running = false
    if Stam.thread then pcall(task.cancel, Stam.thread); Stam.thread = nil end
    if Stam.mod and Stam.saved then
        pcall(function()
            if Stam.saved.MaxStamina   then Stam.mod.MaxStamina   = Stam.saved.MaxStamina   end
            if Stam.saved.StaminaDrain then Stam.mod.StaminaDrain = Stam.saved.StaminaDrain end
            if Stam.saved.StaminaGain  then Stam.mod.StaminaGain  = Stam.saved.StaminaGain  end
            if Stam.saved.Stamina      then Stam.mod.Stamina      = Stam.saved.Stamina      end
        end)
    end
    Stam.saved = nil
end

