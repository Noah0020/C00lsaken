-- HITBOX
-- ============================================================
local function makeHitboxAndCheck(killerModel, onDetected)
    if not killerModel or not killerModel.Parent then return end
    local killerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
    if not killerRoot then return end

    local size = Vector3.new(CONFIG.HitboxWidth, CONFIG.HitboxHeight, CONFIG.HitboxLength)

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { killerModel }

    task.spawn(function()
        local startTime = tick()
        local blockedOnce = false

        while tick() - startTime < CONFIG.HitboxDuration do
            if blockedOnce then break end
            local currentKillerRoot = killerModel:FindFirstChild("HumanoidRootPart") or killerModel:FindFirstChild("RootPart")
            if not currentKillerRoot then break end

            local offset = CFrame.new(0, 0, -(CONFIG.HitboxDistance or 3))
            local frozenCFrame = currentKillerRoot.CFrame * offset

            local hitboxFrame = Instance.new("Part")
            hitboxFrame.Name = "AutoBlockHitbox_Frame"
            hitboxFrame.Transparency = CONFIG.ShowHitboxVisual and CONFIG.HitboxTransparency or 1
            hitboxFrame.CanCollide = false
            hitboxFrame.CanTouch = false
            hitboxFrame.CanQuery = false
            hitboxFrame.CastShadow = false
            hitboxFrame.Anchored = true
            hitboxFrame.Size = size
            hitboxFrame.Color = CONFIG.HitboxColor
            hitboxFrame.Material = Enum.Material.ForceField
            hitboxFrame.CFrame = frozenCFrame
            hitboxFrame.Parent = Workspace

            local selectionBox
            if CONFIG.ShowOutline and CONFIG.ShowHitboxVisual then
                selectionBox = Instance.new("SelectionBox")
                selectionBox.Adornee = hitboxFrame
                selectionBox.Color3 = CONFIG.HitboxColor
                selectionBox.LineThickness = CONFIG.OutlineThickness
                selectionBox.Transparency = CONFIG.OutlineTransparencyValue or 0.6
                selectionBox.Visible = true
                selectionBox.Parent = hitboxFrame
            end

            Debris:AddItem(hitboxFrame, CONFIG.HitboxLifetime)

            local found = false
            for _, part in ipairs(Workspace:GetPartsInPart(hitboxFrame, op)) do
                local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    if Players:GetPlayerFromCharacter(hum.Parent) == LocalPlayer then
                        found = true
                        break
                    end
                end
            end

            if found and not blockedOnce then
                blockedOnce = true
                pcall(function()
                    hitboxFrame.Color = CONFIG.HitboxHitColor
                    if selectionBox then selectionBox.Color3 = CONFIG.HitboxHitColor end
                end)
                if onDetected then onDetected() end
                break
            end

            RunService.Heartbeat:Wait()
        end
    end)
end

local lastAbilityUsed, lastAbilitiesUsed, abilityBaitFlag

local function checkKillerAttackC00l()
    local killers = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    if not killers then return end
    local killer = killers:GetChildren()[1]
    if not killer or not killer:IsA("Model") then return end
    local abilityLastUsed = killer:GetAttribute("AbilityLastUsed") or 0
    local abilitiesUsed = killer:GetAttribute("AbilitiesUsed") or 0
    if lastAbilityUsed == nil then
        lastAbilityUsed = abilityLastUsed
        lastAbilitiesUsed = abilitiesUsed
        return
    end
    if abilitiesUsed > lastAbilitiesUsed then abilityBaitFlag = true end
    if abilityLastUsed > lastAbilityUsed then
        if abilityBaitFlag then
            abilityBaitFlag = false
        else
            makeHitboxAndCheck(killer, function() fireBlock() end)
        end
    end
    lastAbilityUsed = abilityLastUsed
    lastAbilitiesUsed = abilitiesUsed
end

RunService.Heartbeat:Connect(function()
    if CONFIG.AutoBlock then pcall(checkKillerAttackC00l) end
end)

local function setAutoBlock(on)
    CONFIG.AutoBlock = on
    if on then
        lastAbilityUsed = nil
        lastAbilitiesUsed = nil
        abilityBaitFlag = false
    end
end

