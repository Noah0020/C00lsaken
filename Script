local function fireBlock()
    local ui = getMainUI()
    local abilityContainer = ui and ui:FindFirstChild("AbilityContainer")
    local blockBtn = abilityContainer and abilityContainer:FindFirstChild("Block")

    if blockBtn then
        local clickBtn =
            blockBtn:FindFirstChildOfClass("ImageButton")
            or blockBtn:FindFirstChildOfClass("TextButton")
            or blockBtn

        if clickBtn and (
            clickBtn:IsA("ImageButton")
            or clickBtn:IsA("TextButton")
        ) then
            local fired = false

            if firesignal then
                pcall(function()
                    firesignal(clickBtn.MouseButton1Click)
                    firesignal(clickBtn.MouseButton1Down)
                    firesignal(clickBtn.MouseButton1Up)
                    fired = true
                end)
            end

            if not fired then
                pcall(function()
                    clickBtn.MouseButton1Click:Fire()
                    clickBtn.MouseButton1Down:Fire()
                end)
            end

            if triggerHDTFromBlock then
                triggerHDTFromBlock()
            end

            return true
        end
    end

    local re = getRemote()
    if not re then return false end

    local success = pcall(function()
        re:FireServer(
            "UseActorAbility",
            { buffer.fromstring("\3\5\0\0\0Block") }
        )
    end)

    if success and triggerHDTFromBlock then
        triggerHDTFromBlock()
    end

    return success
end

