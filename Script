-- CUSTOM ZONE (goodsaken diamond + circle)
-- ═══════════════════════════════════════════════════════════════
local CustomZone = {running=false, connections={}, folder=nil, killerZones={}}
local PLAYER_RADIUS = 1.5
local zoneStateMemory = {diamond=false, circle=false}

local function GetKillerGroundCF(kr)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {kr.Parent, LocalPlayer.Character}
    params.IgnoreWater = true
    local ray = Workspace:Raycast(kr.Position, Vector3.new(0,-30,0), params)
    local gy  = ray and (kr.Position.Y - ray.Distance) or (kr.Position.Y - 3)
    return CFrame.new(kr.Position.X, gy+(Settings.ZoneHeight or 0.5), kr.Position.Z)*kr.CFrame.Rotation
end

local function BuildZone(killer)
    local model = Instance.new("Model")
    model.Name   = "ABZone_"..killer.Name
    model.Parent = CustomZone.folder
    local RED = Color3.fromRGB(220,0,0)
    local edges = {}
    for i = 1,4 do
        local p = Instance.new("Part")
        p.Name="Edge"..i; p.Anchored=true; p.CanCollide=false; p.CanQuery=false
        p.CanTouch=false; p.CastShadow=false; p.Material=Enum.Material.Neon
        p.Color=RED; p.Transparency=0.3; p.Size=Vector3.new(0.35,0.08,1)
        p.CFrame=CFrame.new(0,-5000,0); p.Parent=model; edges[i]=p
    end
    local circle = Instance.new("Part")
    circle.Shape=Enum.PartType.Cylinder; circle.Name="Circle"
    circle.Anchored=true; circle.CanCollide=false; circle.CanQuery=false
    circle.CanTouch=false; circle.CastShadow=false; circle.Material=Enum.Material.Neon
    circle.Color=RED; circle.Transparency=0.65; circle.Size=Vector3.new(0.08,10,10)
    circle.CFrame=CFrame.new(0,-5000,0); circle.Parent=model
    return {model=model, edges=edges, circle=circle, killer=killer}
end

local function IsPlayerInDiamond(myPos, kCF, kPos)
    if not Settings.ShowDiamond then return false end
    local fwd   = Vector3.new(kCF.LookVector.X,0,kCF.LookVector.Z)
    local right = Vector3.new(kCF.RightVector.X,0,kCF.RightVector.Z)
    if fwd.Magnitude < 0.01 or right.Magnitude < 0.01 then return false end
    fwd=fwd.Unit; right=right.Unit
    local toP = Vector3.new(myPos.X-kPos.X,0,myPos.Z-kPos.Z)
    local dF   = toP:Dot(fwd) - (Settings.CustomDiamondOffset + Settings.CustomDiamondLength/2)
    local dR   = toP:Dot(right)
    return math.abs(dR)/(Settings.CustomDiamondWidth/2+PLAYER_RADIUS)
         + math.abs(dF)/(Settings.CustomDiamondLength/2+PLAYER_RADIUS) <= 1
end

local function IsPlayerInCircle(myPos, kPos)
    if not Settings.ShowCircle then return false end
    local dx = myPos.X - kPos.X; local dz = myPos.Z - kPos.Z
    local r  = Settings.CustomCircleRadius + PLAYER_RADIUS
    return dx*dx + dz*dz <= r*r
end

local function IsPlayerInCustomZone(killer)
    if not killer or not killer.Parent then return false end
    local kr = killer:FindFirstChild("HumanoidRootPart")
    local mc = LocalPlayer.Character
    local mr = mc and mc:FindFirstChild("HumanoidRootPart")
    if not (kr and mr) then return false end
    return IsPlayerInDiamond(mr.Position, kr.CFrame, kr.Position)
        or IsPlayerInCircle(mr.Position, kr.Position)
end

local function UpdateZone(zone, kr, myRoot)
    if not (zone and zone.model and zone.model.Parent) then return end
    if not (kr and kr.Parent) then return end
    local bCF   = GetKillerGroundCF(kr)
    local off   = Settings.CustomDiamondOffset
    local L,W   = Settings.CustomDiamondLength, Settings.CustomDiamondWidth
    local wA = bCF:PointToWorldSpace(Vector3.new(0,0,-off))
    local wB = bCF:PointToWorldSpace(Vector3.new(0,0,-(off+L)))
    local wC = bCF:PointToWorldSpace(Vector3.new(-W/2,0,-(off+L/2)))
    local wD = bCF:PointToWorldSpace(Vector3.new(W/2,0,-(off+L/2)))
    for i, spec in ipairs({{wA,wC},{wA,wD},{wB,wC},{wB,wD}}) do
        local p1,p2 = spec[1],spec[2]; local diff = p2-p1; local len = diff.Magnitude
        if len > 0.01 then
            local e = zone.edges[i]
            if e then e.Size=Vector3.new(0.35,0.08,len); e.CFrame=CFrame.lookAt((p1+p2)/2,(p1+p2)/2+diff.Unit); e.Transparency=Settings.ShowDiamond and 0.3 or 1 end
        end
    end
    if zone.circle then
        local cc = Vector3.new(bCF.Position.X, bCF.Position.Y+0.04, bCF.Position.Z)
        zone.circle.Size  = Vector3.new(0.08, Settings.CustomCircleRadius*2, Settings.CustomCircleRadius*2)
        zone.circle.CFrame= CFrame.new(cc)*CFrame.Angles(0,0,math.rad(90))
        zone.circle.Transparency = Settings.ShowCircle and 0.65 or 1
    end
    local GREEN = Color3.fromRGB(0,255,0)
    local RED   = Color3.fromRGB(220,0,0)
    local inD   = myRoot and IsPlayerInDiamond(myRoot.Position, kr.CFrame, kr.Position)
    local inC   = myRoot and IsPlayerInCircle(myRoot.Position, kr.Position)
    for _, e in ipairs(zone.edges) do if e and e.Parent then e.Color = inD and GREEN or RED end end
    if zone.circle and zone.circle.Parent then zone.circle.Color = inC and GREEN or RED end
end

local function StartCustomZoneVisuals()
    if CustomZone.running then return end
    CustomZone.running = true; CustomZone.connections = {}; CustomZone.killerZones = {}
    CustomZone.folder  = Instance.new("Folder")
    CustomZone.folder.Name="ABCustomZoneVisuals"; CustomZone.folder.Parent=Workspace
    table.insert(CustomZone.connections, RunService.RenderStepped:Connect(function()
        if not CustomZone.running then return end
        local kf = GetKillersFolder(); if not kf then return end
        local mc = LocalPlayer.Character
        local mr = mc and mc:FindFirstChild("HumanoidRootPart")
        for _, killer in ipairs(kf:GetChildren()) do
            if killer:IsA("Model") then
                local kr = killer:FindFirstChild("HumanoidRootPart")
                if kr then
                    local z = CustomZone.killerZones[killer]
                    if not z or not z.model or not z.model.Parent then
                        if z and z.model then pcall(function() z.model:Destroy() end) end
                        z = BuildZone(killer); CustomZone.killerZones[killer] = z
                    end
                    UpdateZone(z, kr, mr)
                end
            end
        end
        for killer, z in pairs(CustomZone.killerZones) do
            if not killer.Parent then
                if z.model then pcall(function() z.model:Destroy() end) end
                CustomZone.killerZones[killer] = nil
            end
        end
    end))
end

local function StopCustomZoneVisuals()
    if not CustomZone.running then return end
    CustomZone.running = false
    for _, c in ipairs(CustomZone.connections) do pcall(function() c:Disconnect() end) end
    CustomZone.connections = {}
    for _, z in pairs(CustomZone.killerZones) do if z.model then pcall(function() z.model:Destroy() end) end end
    CustomZone.killerZones = {}
    if CustomZone.folder then pcall(function() CustomZone.folder:Destroy() end); CustomZone.folder=nil end
end

local function UpdateCustomZoneVisibility()
    local show = Settings.ShowDiamond or Settings.ShowCircle
    if show and not CustomZone.running then StartCustomZoneVisuals()
    elseif not show and CustomZone.running then StopCustomZoneVisuals() end
end

