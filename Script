local AB = { running=false, conn=nil, attrStates={}, attrDebounce=0 }

local function InCircleRange(kr, myRoot)
    -- Match the flat detection circle shown around the local player.
    local dx = kr.Position.X - myRoot.Position.X
    local dz = kr.Position.Z - myRoot.Position.Z
    return (dx * dx + dz * dz) <= (State.DetectionRange * State.DetectionRange)
end

local function InBoxRange(kr, myPos)
    local cf = CalcRectCF(kr)
    local lp = cf:PointToObjectSpace(myPos)
    return math.abs(lp.X) <= State.BoxWidth / 2
        and math.abs(lp.Y) <= State.BoxHeight / 2
        and math.abs(lp.Z) <= State.BoxLength / 2
end

local function InConeRange(kr, myPos)
    local cf = GetFlatLook(kr)
    local lp = cf:PointToObjectSpace(myPos)
    local depth = -lp.Z
    if depth < 0 or depth > State.ConeLength then return false end
    if math.abs(lp.Y) > 5 then return false end
    local halfWidthAtDepth = (State.ConeWidth / 2) * (depth / math.max(State.ConeLength, 0.01))
    return math.abs(lp.X) <= halfWidthAtDepth
end

local function IsInsideSelectedShape(kr, myRoot)
    if State.AutoBlockShape == "Box" then
        return InBoxRange(kr, myRoot.Position)
    elseif State.AutoBlockShape == "Cone" then
        return InConeRange(kr, myRoot.Position)
    end
    return InCircleRange(kr, myRoot)
end

local function AttrHeartbeat()
    if not AB.running or not KillersFolder then return end
    if not Player.Character then return end
    local myRoot = Player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myHum = Player.Character:FindFirstChildOfClass("Humanoid")
    if myHum and myHum.Health <= 0 then return end

    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") then
            local kr = k:FindFirstChild("HumanoidRootPart")
            if kr then
                local alu = k:GetAttribute("AbilityLastUsed") or 0
                local au = k:GetAttribute("AbilitiesUsed") or 0
                local st = AB.attrStates[k]
                if st then
                    local inc = alu > st.lastAbility
                    if au > st.lastUsed then st.isBait = true end
                    if inc then
                        local n = tick()
                        if st.castLockUntil and n < st.castLockUntil then
                            st.lastAbility = alu; st.lastUsed = au
                        else
                            if st.isBait then
                                st.isBait = false
                            else
                                st.castLockUntil = n + 0.25
                                -- Snapshot the selected zone for this attack. The same zone
                                -- must still be selected and the player must still be inside it
                                -- at the exact moment the block is sent.
                                local selectedShape = State.AutoBlockShape
                                local inRange = IsInsideSelectedShape(kr, myRoot)
                                if inRange then
                                    local wallOk = not State.WallCheck or not HasWallBetween(kr.Position, myRoot.Position, k)
                                    if wallOk and (n - (st.lastBlockTime or 0)) >= 0.15 then
                                        st.lastBlockTime = n
                                        if State.BlockDelay > 0 then task.wait(State.BlockDelay) end

                                        local currentCharacter = Player.Character
                                        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
                                        local currentHum = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
                                        local stillValid = AB.running
                                            and State.AutoBlock
                                            and State.AutoBlockShape == selectedShape
                                            and k.Parent == KillersFolder
                                            and kr.Parent == k
                                            and currentRoot ~= nil
                                            and (not currentHum or currentHum.Health > 0)
                                            and IsInsideSelectedShape(kr, currentRoot)

                                        if stillValid then
                                            local finalWallOk = not State.WallCheck or not HasWallBetween(kr.Position, currentRoot.Position, k)
                                            if finalWallOk then
                                                if State.BlockMode == "007n7" then FireClone() else FireBlock() end
                                                if State.MessageOnBlock and State.BlockMessage ~= "" then
                                                    pcall(function()
                                                        TextChatService.TextChannels.RBXGeneral:SendAsync(State.BlockMessage)
                                                    end)
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                            st.lastAbility = alu
                            st.lastUsed = au
                        end
                    else
                        st.lastAbility = alu
                        st.lastUsed = au
                    end
                else
                    AB.attrStates[k] = { lastAbility=alu, lastUsed=au, isBait=false, castLockUntil=0, lastBlockTime=0 }
                end
            end
        end
    end
end

local function StartAutoBlock()
    if AB.running then return end
    AB.running = true
    AB.attrStates = {}
    AB.conn = RunService.Heartbeat:Connect(AttrHeartbeat)
end
local function StopAutoBlock()
    AB.running = false
    if AB.conn then AB.conn:Disconnect(); AB.conn = nil end
    AB.attrStates = {}
end

