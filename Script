--═══════════════════════════════════════════════════════════════════
-- GENERATOR SOLVER — Flow (dots), Gear, Connect, Lock
--═══════════════════════════════════════════════════════════════════
local GS = {
    installed = false,
    generation = 0,
    lockBoard = nil,
}

local GSM = {}  -- module cache

local function gs_safeRequire(path)
    local ok, res = pcall(function() return require(path) end)
    return ok and res or nil
end

local function gs_loadModules()
    if GSM.flow and GSM.gear and GSM.connect and GSM.lock and GSM.flowBoard and GSM.lockBoard then
        return true
    end
    local systems = ReplicatedStorage:FindFirstChild("Systems")
    local playerMod = systems and systems:FindFirstChild("Player")
    local gameMod = playerMod and playerMod:FindFirstChild("Game")
    local miniFolder = gameMod and gameMod:FindFirstChild("Minigames")
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local miniMods = mods and mods:FindFirstChild("Minigames")

    if not miniFolder or not miniMods then return false end

    GSM.flow = gs_safeRequire(miniFolder:FindFirstChild("FlowClientMinigame") and miniFolder.FlowClientMinigame:FindFirstChild("FlowInput") or nil)
    GSM.gear = gs_safeRequire(miniFolder:FindFirstChild("GearClientMinigame") and miniFolder.GearClientMinigame:FindFirstChild("GearInput") or nil)
    GSM.connect = gs_safeRequire(miniFolder:FindFirstChild("ConnectClientMinigame") and miniFolder.ConnectClientMinigame:FindFirstChild("ConnectInput") or nil)
    GSM.lock = gs_safeRequire(miniFolder:FindFirstChild("LockClientMinigame") and miniFolder.LockClientMinigame:FindFirstChild("LockInput") or nil)
    GSM.flowBoard = gs_safeRequire(miniMods:FindFirstChild("FlowBoard"))
    GSM.lockBoard = gs_safeRequire(miniMods:FindFirstChild("LockBoard"))

    return GSM.flow and GSM.gear and GSM.connect and GSM.lock and GSM.flowBoard and GSM.lockBoard
end

local function gs_isEnabled()
    return Settings.GS_Enabled
end

local function gs_stillSolving(object)
    return gs_isEnabled() and object and not object.Ended
end

local function gs_waitForSolver(object)
    while object and not object.Ended and not gs_isEnabled() do task.wait(0.05) end
    if not (object and not object.Ended and gs_isEnabled()) then return false end
    local started = os.clock()
    while object and not object.Ended and gs_isEnabled() and os.clock() - started < Settings.GS_StartDelay do
        task.wait(0.05)
    end
    return object and not object.Ended and gs_isEnabled()
end

local function gs_solveFlowBoard(board, FlowBoardModule)
    local size, pairMap = board.Size, board.Pairs
    local occupied, answer = {}, {}
    local directions = { {-1, 0}, {1, 0}, {0, -1}, {0, 1} }
    local endpointOwner = {}
    for color, pair in pairs(pairMap) do
        endpointOwner[pair[1]], endpointOwner[pair[2]] = color, color
    end
    local remaining = {}
    for color in pairs(pairMap) do table.insert(remaining, color) end

    local function candidates(color, limit)
        local pair = pairMap[color]
        local from, target = pair[1], pair[2]
        local results, path, seen = {}, {from}, {[from] = true}
        local function distance(cell)
            local r, c = FlowBoardModule.ToRowCol(size, cell)
            local tr, tc = FlowBoardModule.ToRowCol(size, target)
            return math.abs(r - tr) + math.abs(c - tc)
        end
        local function walk(cell)
            if #results >= limit then return end
            if cell == target then
                table.insert(results, table.clone(path)); return
            end
            local row, col = FlowBoardModule.ToRowCol(size, cell)
            local nextCells = {}
            for _, d in ipairs(directions) do
                local nr, nc = row + d[1], col + d[2]
                if nr >= 1 and nr <= size and nc >= 1 and nc <= size then
                    local n = FlowBoardModule.ToIndex(size, nr, nc)
                    local owner = endpointOwner[n]
                    if not seen[n] and not occupied[n]
                       and (not owner or (owner == color and n == target)) then
                        table.insert(nextCells, n)
                    end
                end
            end
            table.sort(nextCells, function(a, b) return distance(a) < distance(b) end)
            for _, n in ipairs(nextCells) do
                seen[n] = true; table.insert(path, n)
                walk(n)
                path[#path] = nil; seen[n] = nil
                if #results >= limit then break end
            end
        end
        walk(from)
        table.sort(results, function(a, b) return #a < #b end)
        return results
    end

    local function search(colors)
        if #colors == 0 then return true end
        local bestIndex, bestPaths
        for i, color in ipairs(colors) do
            local list = candidates(color, 300)
            if #list == 0 then return false end
            if not bestPaths or #list < #bestPaths then bestIndex, bestPaths = i, list end
        end
        local color = colors[bestIndex]
        local nextColors = table.clone(colors)
        table.remove(nextColors, bestIndex)
        for _, path in ipairs(bestPaths) do
            for _, cell in ipairs(path) do occupied[cell] = true end
            answer[color] = path
            if search(nextColors) then return true end
            answer[color] = nil
            for _, cell in ipairs(path) do occupied[cell] = nil end
        end
        return false
    end
    return search(remaining) and answer or nil
end

local function gs_install()
    if GS.installed then return true end
    if not gs_loadModules() then return false end
    GS.installed = true

    local oldLockBoardNew = GSM.lockBoard.new
    GSM.lockBoard.new = function(...)
        local board = oldLockBoardNew(...)
        GS.lockBoard = board
        return board
    end

    local oldFlowNew = GSM.flow.new
    GSM.flow.new = function(board, renderer, callbacks)
        local object = oldFlowNew(board, renderer, callbacks)
        task.spawn(function()
            if not gs_waitForSolver(object) then return end
            task.wait(Settings.GS_FlowDelay)
            local paths = gs_solveFlowBoard(board, GSM.flowBoard)
            if not paths then return end
            for color, path in pairs(paths) do
                if not gs_stillSolving(object) then return end
                local drawing = board:Begin(path[1])
                renderer:Render()
                task.wait(Settings.GS_FlowDelay)
                for index = 2, #path do
                    if not gs_stillSolving(object) then return end
                    board:Step(drawing, path[index], 0)
                    renderer:Render()
                    task.wait(Settings.GS_FlowDelay)
                end
                board:Release(drawing, true)
                renderer:Render()
                task.wait(Settings.GS_FlowDelay)
            end
            if gs_stillSolving(object) and board:IsSolved() then
                object:__finish()
                callbacks.OnSolved()
            end
        end)
        return object
    end

    local oldConnectNew = GSM.connect.new
    GSM.connect.new = function(board, renderer, callbacks)
        local object = oldConnectNew(board, renderer, callbacks)
        task.spawn(function()
            if not gs_waitForSolver(object) then return end
            task.wait(Settings.GS_ConnectDelay)
            for blob in pairs(board.Blobs) do
                if not gs_stillSolving(object) then return end
                if not board:GetLink(blob) then
                    local mate = board:GetMate(blob)
                    if mate then
                        board:Connect(blob, mate)
                        renderer:Render()
                        task.wait(Settings.GS_ConnectDelay)
                    end
                end
            end
            if gs_stillSolving(object) and board:IsSolved() then
                object:__finish()
                callbacks.OnSolved()
            end
        end)
        return object
    end

    local oldGearNew = GSM.gear.new
    GSM.gear.new = function(getCenter, callbacks, enabled)
        local object = oldGearNew(getCenter, callbacks, enabled)
        task.spawn(function()
            if not gs_waitForSolver(object) then return end
            task.wait(math.max(0.55, Settings.GS_FlowDelay))
            for _ = 1, 100 do
                if not gs_stillSolving(object) then return end
                callbacks.OnTurn(90)
                task.wait(Settings.GS_GearDelay)
            end
        end)
        return object
    end

    local oldLockNew = GSM.lock.new
    GSM.lock.new = function(ui, callbacks)
        local object = oldLockNew(ui, callbacks)
        local board = GS.lockBoard
        task.spawn(function()
            if not gs_waitForSolver(object) then return end
            while gs_stillSolving(object) and board and not board:IsBroken() do
                local now = workspace:GetServerTimeNow()
                if board:IsOnTarget(board:AngleAt(now)) then
                    callbacks.OnPress()
                    task.wait(math.max(Settings.GS_LockDelay, Settings.GS_FlowDelay))
                else
                    RunService.Heartbeat:Wait()
                end
            end
        end)
        return object
    end

    return true
end

local function GS_Enable()
    if not gs_install() then
        return false
    end
    Settings.GS_Enabled = true
    GS.generation = GS.generation + 1
    return true
end

local function GS_Disable()
    Settings.GS_Enabled = false
    GS.generation = GS.generation + 1
end

