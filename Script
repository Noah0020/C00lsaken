local itemHighlights = { Medkit = {}, BloxyCola = {} }
local function applyItemHighlight(item)
    if not item or not item.Parent then return end
    local name = item.Name
    if name ~= "Medkit" and name ~= "BloxyCola" then return end
    if name == "Medkit" and not State.MedkitESP then return end
    if name == "BloxyCola" and not State.BloxyESP then return end
    if item:FindFirstChild("ItemESP") then return end
    local target = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not target then return end
    local hl = Instance.new("Highlight")
    hl.Name = "ItemESP"
    hl.Adornee = item
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if name == "Medkit" then
        hl.FillColor = Color3.fromRGB(255, 105, 180)
        hl.OutlineColor = Color3.fromRGB(255, 105, 180)
    else
        hl.FillColor = Color3.fromRGB(0, 150, 255)
        hl.OutlineColor = Color3.fromRGB(0, 150, 255)
    end
    hl.Parent = target
    table.insert(itemHighlights[name], hl)
end
local function clearItemESP(name)
    for _, h in ipairs(itemHighlights[name]) do if h and h.Parent then h:Destroy() end end
    itemHighlights[name] = {}
end
local function scanItems(name)
    clearItemESP(name)
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item.Name == name then applyItemHighlight(item) end
    end
end

local genConns = {}
local function attachGenerator(obj)
    if not obj or not obj.Parent then return end
    if obj:FindFirstChild("GenESP") then return end
    local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if not root then return end
    local hl = Instance.new("Highlight")
    hl.Name = "GenESP"
    hl.FillColor = Color3.fromRGB(255, 255, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = obj
    hl.Parent = obj
    local bb = Instance.new("BillboardGui")
    bb.Name = "GenESP_bb"
    bb.Adornee = root
    bb.Size = UDim2.new(0, 100, 0, 20)
    bb.StudsOffset = Vector3.new(0, 3.8, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 1000
    bb.Parent = obj
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
    lbl.TextStrokeTransparency = 0.5
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextSize = 15
    lbl.Font = Enum.Font.SourceSansBold
    lbl.Text = "Generator"
    lbl.Parent = bb
    local prog = obj:FindFirstChild("Progress")
    if prog and prog:IsA("NumberValue") then
        lbl.Text = "Generator (" .. math.floor(prog.Value) .. "%)"
        genConns[obj] = prog.Changed:Connect(function()
            if lbl.Parent then lbl.Text = "Generator (" .. math.floor(prog.Value) .. "%)" end
        end)
    end
end
local function detachGenerator(obj)
    if not obj then return end
    if genConns[obj] then genConns[obj]:Disconnect(); genConns[obj] = nil end
    local h = obj:FindFirstChild("GenESP"); if h then h:Destroy() end
    local b = obj:FindFirstChild("GenESP_bb"); if b then b:Destroy() end
end
local function scanGenerators()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Generator" then
            if State.GeneratorESP then attachGenerator(obj) else detachGenerator(obj) end
        end
    end
end

