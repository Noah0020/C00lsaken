-- STAMINA
-- ============================================================
local ok, sprintModule = pcall(function()
    return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
end)

if ok and sprintModule and not sprintModule.DefaultsSet then
    pcall(function()
        if type(sprintModule.Init) == "function" then
            sprintModule.Init()
        end
    end)
end

local function setStaminaField(field, value)
    if not (ok and sprintModule) then return false end
    local success = pcall(function()
        sprintModule[field] = value
    end)
    return success
end

local maxStaminaValue   = (ok and sprintModule and sprintModule.MaxStamina) or 100
local sprintSpeedValue  = (ok and sprintModule and sprintModule.SprintSpeed) or 24
local staminaGainValue  = (ok and sprintModule and sprintModule.StaminaGain) or 10
local staminaDrainValue = (ok and sprintModule and sprintModule.StaminaDrain) or 1
local regenDelayValue   = (ok and sprintModule and sprintModule.StaminaRegenDelay) or 0.5

local infStaminaActive, staminaThread = false, nil

local function enableInfStamina()
    if not ok or not sprintModule or infStaminaActive then return end
    infStaminaActive = true
    setStaminaField("MaxStamina", maxStaminaValue)
    setStaminaField("SprintSpeed", sprintSpeedValue)
    setStaminaField("StaminaGain", staminaGainValue)
    setStaminaField("StaminaDrain", staminaDrainValue)
    setStaminaField("StaminaRegenDelay", regenDelayValue)
    staminaThread = task.spawn(function()
        while infStaminaActive do
            setStaminaField("Stamina", maxStaminaValue)
            task.wait(0.1)
        end
    end)
end

local function disableInfStamina()
    infStaminaActive = false
    if staminaThread then task.cancel(staminaThread); staminaThread = nil end
end

