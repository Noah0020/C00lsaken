-- Cached target (nearest killer)
local aimCachedTargetHRP = nil

local function updateAimTarget()
    local myRoot = aimGetRoot(LocalPlayer.Character)
    if not myRoot then aimCachedTargetHRP = nil return end
    local folder = aimGetTargetFolder()
    if not folder then aimCachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(folder:GetChildren()) do
        if s:IsA("Model") and s ~= LocalPlayer.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    aimCachedTargetHRP = best
end

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(updateAimTarget)
    end
end)

-- Prediction (uses cachedPing, no per-frame ping lookups)
local function predictHRP(hrp)
    if not hrp then return nil end
    if AIM.PredictMode == "Off" then
        return hrp.Position
    end

    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end

    local usePing = isPingAbility(aimCurrentAbility)

    local velLead  = 0
    local pingLead = 0

    if AIM.PredictMode == "Velocity" or AIM.PredictMode == "Both" then
        velLead = AIM.PredictLead
    end

    if usePing and (AIM.PredictMode == "Ping" or AIM.PredictMode == "Both") then
        pingLead = math.clamp(cachedPing * 0.5 * AIM.PingMultiplier, 0, 0.5)
    end

    local totalLead = math.clamp(velLead + pingLead, 0, 0.75)
    return hrp.Position + vel * totalLead
end

local function applyAim(targetPos, mode, smooth)
    if not targetPos then return end
    smooth = smooth or AIM.Smooth
    local cam = Workspace.CurrentCamera
    if not cam then return end

    if mode == "Camera" or mode == "HRP+Camera" then
        cam.CFrame = cam.CFrame:Lerp(
            CFrame.lookAt(cam.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local myRoot = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
            if (flat - myRoot.Position).Magnitude > 0.1 then
                myRoot.CFrame = myRoot.CFrame:Lerp(
                    CFrame.lookAt(myRoot.Position, flat), smooth)
            end
        end
    end
end

-- The optimized RenderStepped aim loop
RunService.RenderStepped:Connect(function()
    if not AIM.Enabled then return end
    if not AIM.MatchActive then return end
    if not AIM.PlayingSurvivor then return end
    if not aimEventActive then return end
    if not aimCachedTargetHRP or not aimCachedTargetHRP.Parent then return end

    local targetPos = predictHRP(aimCachedTargetHRP)
    applyAim(targetPos, AIM.AimMode, AIM.Smooth)
end)

