--═══════════════════════════════════════════════════════════════════
local HDT = { running=false, debounce=false, animConn=nil, watcher=nil,
              charConn=nil, bind="GS_HDT_Bind", lastDmg=0, active=nil }

local function HDT_Nearest()
    local kf = GetKillersFolder(); if not kf or not LocalRoot then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        if kr then
            local d = (kr.Position - LocalRoot.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end

local function HDT_Dash(killer)
    if HDT.debounce or not killer or not killer.Parent then return end
    local char = LocalPlayer.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local kr = killer:FindFirstChild("HumanoidRootPart") or killer.PrimaryPart
    if not kr or (kr.Position - hrp.Position).Magnitude < 2.5 then return end

    HDT.debounce = true
    local oWS, oAR = hum.WalkSpeed, hum.AutoRotate
    HDT.active = { hum=hum, walkSpeed=oWS, autoRotate=oAR }
    hum.WalkSpeed, hum.AutoRotate = Settings.HDT_Speed, true
    local st = tick()

    local function stop()
        HDT.debounce = false; HDT.active = nil
        pcall(function() RunService:UnbindFromRenderStep(HDT.bind) end)
        if hum and hum.Parent then
            pcall(function()
                hum:Move(Vector3.new(), false)
                hum.WalkSpeed = oWS; hum.AutoRotate = oAR
            end)
        end
    end

    pcall(function() RunService:UnbindFromRenderStep(HDT.bind) end)
    RunService:BindToRenderStep(HDT.bind, Enum.RenderPriority.Last.Value + 1, function()
        if not HDT.debounce then stop(); return end
        if not char.Parent or not killer.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        local kt = killer:FindFirstChild("HumanoidRootPart"); if not kt then stop(); return end
        local flat = Vector3.new(kt.Position.X - hrp.Position.X, 0, kt.Position.Z - hrp.Position.Z)
        if flat.Magnitude <= 2 then stop(); return end
        hum.WalkSpeed = Settings.HDT_Speed
        hum:Move(flat.Unit, false)
        if tick() - st > Settings.HDT_Duration then stop() end
    end)
end

local function HDT_OnAnim(track)
    if not HDT.running or HDT.debounce then return end
    if tick() - HDT.lastDmg < 0.2 then return end
    local aid = track.Animation and track.Animation.AnimationId
    if not aid or not HDT_Anims[aid] then return end
    local k = HDT_Nearest(); if not k then return end
    task.delay(Settings.HDT_Delay, function() if HDT.running then HDT_Dash(k) end end)
end

local function HDT_Attach()
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local anim = hum:FindFirstChildOfClass("Animator"); if not anim then return end
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end) end
    HDT.animConn = anim.AnimationPlayed:Connect(HDT_OnAnim)
end

local function HDT_Enable()
    if HDT.running then return end
    HDT.running = true; HDT_Attach()
    HDT.charConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5); if HDT.running then HDT_Attach() end
    end)
    HDT.watcher = task.spawn(function()
        while HDT.running do
            if not HDT.animConn then HDT_Attach() end
            task.wait(1)
        end
    end)
end

local function HDT_Disable()
    HDT.running = false
    if HDT.active and HDT.active.hum and HDT.active.hum.Parent then
        local h = HDT.active.hum
        pcall(function()
            h:Move(Vector3.new(), false)
            h.WalkSpeed = HDT.active.walkSpeed
            h.AutoRotate = HDT.active.autoRotate
        end)
    end
    HDT.active = nil; HDT.debounce = false
    if HDT.animConn then pcall(function() HDT.animConn:Disconnect() end); HDT.animConn=nil end
    if HDT.charConn then pcall(function() HDT.charConn:Disconnect() end); HDT.charConn=nil end
    if HDT.watcher then pcall(task.cancel, HDT.watcher); HDT.watcher=nil end
    pcall(function() RunService:UnbindFromRenderStep(HDT.bind) end)
end

