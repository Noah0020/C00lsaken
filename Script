local function AM1_CreateRangeRing()
    AM1_DestroyRangeRing()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local SEG = 40
    local attachments = {}
    for i = 1, SEG do
        local angle = (i / SEG) * math.pi * 2
        local a = Instance.new("Attachment")
        a.Name = "AM1RingPt"
        a.Position = Vector3.new(math.cos(angle)*Settings.AM1_Range, -(hrp.Size.Y/2)+0.2, math.sin(angle)*Settings.AM1_Range)
        a.Parent = hrp
        table.insert(attachments, a)
        table.insert(AM1.rangeRingParts, a)
    end
    for i = 1, SEG do
        local nextI = (i % SEG) + 1
        local beam = Instance.new("Beam")
        beam.Attachment0 = attachments[i]
        beam.Attachment1 = attachments[nextI]
        beam.Width0, beam.Width1 = 0.3, 0.3
        beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
        beam.Transparency = NumberSequence.new(1 - (Settings.AM1_RangeOpacity or 1))
