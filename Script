-- Asset reading
local Assets = ReplicatedStorage:FindFirstChild("Assets")
    or ReplicatedStorage:WaitForChild("Assets", 10)

local aimAnimIds  = {}
local aimSoundIds = {}

local function pushIdsFromValue(value, intoSet, abilityName)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id and not intoSet[id] then intoSet[id] = abilityName end
    elseif type(value) == "table" then
        for _, v in pairs(value) do
            pushIdsFromValue(v, intoSet, abilityName)
        end
    end
end

local AIM_SOUND_FIELDS = {
    "Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds",
}

local function readConfigAnimations(module, charName, skinName)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end

    if type(cfg.Animations) == "table" then
        for key, value in pairs(cfg.Animations) do
            if AIM_ANIM_KEYS[key] then
                pushIdsFromValue(value, aimAnimIds, key)
            end
        end
    end

    for _, field in ipairs(AIM_SOUND_FIELDS) do
        local soundTable = cfg[field]
        if type(soundTable) == "table" then
            for key, value in pairs(soundTable) do
                if AIM_SOUND_KEYS[key] then
                    pushIdsFromValue(value, aimSoundIds, key)
                end
            end
        end
    end
end

local function loadMyAbilityIds(char)
    aimAnimIds  = {}
    aimSoundIds = {}

    if not Assets then
        warn("[Aim] ReplicatedStorage.Assets not found")
        return
    end

    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"

    local survivorsFolder = Assets:FindFirstChild("Survivors")
    local survivorFolder  = survivorsFolder and survivorsFolder:FindFirstChild(charName)
    if survivorFolder then
        local baseCfg = survivorFolder:FindFirstChild("Config")
        if baseCfg then
            readConfigAnimations(baseCfg, charName, "Default")
        end
    end

    if skinName and skinName ~= "Default" then
        local skinsRoot  = Assets:FindFirstChild("Skins")
        local skinsSurv  = skinsRoot and skinsRoot:FindFirstChild("Survivors")
        local skinChar   = skinsSurv and skinsSurv:FindFirstChild(charName)
        local skinFolder = skinChar and skinChar:FindFirstChild("SkinName" and skinName)
        if skinFolder then
            local skinCfg = skinFolder:FindFirstChild("Config")
            if skinCfg then
                readConfigAnimations(skinCfg, charName, skinName)
            end
        end
    end
end

-- Event gate
local aimEventActive    = false
local aimEventRefCount  = 0
local aimCurrentAbility = nil

local function pushEvent(name)
    aimEventRefCount += 1
    aimEventActive = true
    aimCurrentAbility = name
    if AIM.Debug then
        print(string.format("[Aim] event start (%d) name=%s", aimEventRefCount, tostring(name)))
    end
end

local function popEvent()
    aimEventRefCount = math.max(0, aimEventRefCount - 1)
    if aimEventRefCount == 0 then
        aimEventActive = false
        aimCurrentAbility = nil
        if AIM.Debug then
            print("[Aim] event end")
        end
    end
end

local function isPingAbility(name)
    return name and AIM_PING_ABILITIES[name] == true
end

-- Anim + sound watchers
local aimAnimConn = nil
local aimSoundConns = {}

local function attachAnimWatcher(char)
    if aimAnimConn then
        pcall(function() aimAnimConn:Disconnect() end)
        aimAnimConn = nil
    end

    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)
    if not animator then return end

    aimAnimConn = animator.AnimationPlayed:Connect(function(track)
        local anim = track.Animation
        if not anim then return end
        local animId = tostring(anim.AnimationId):match("%d+")
        if not animId then return end

        local abilityName = aimAnimIds[animId]
        if not abilityName then return end

        pushEvent(abilityName)

        local ended = false
        local function finish()
            if ended then return end
            ended = true
            popEvent()
        end
        track.Stopped:Once(finish)
        local dur = track.Length
        if not dur or dur <= 0 then dur = 0.5 end
        task.delay(dur + 0.2, finish)
    end)
end

local function soundIdOf(sound)
    if not sound or not sound.SoundId then return nil end
    return tostring(sound.SoundId):match("%d+")
end

local function hookMySound(s)
    if not s:IsA("Sound") then return end
    return s.Playing:Connect(function()
        local sid = soundIdOf(s)
        if not sid then return end
        local abilityName = aimSoundIds[sid]
        if not abilityName then return end
        pushEvent(abilityName)
        local dur = s.TimeLength
        if not dur or dur <= 0 then dur = 0.4 end
        task.delay(dur + 0.15, popEvent)
    end)
end

local function attachSoundWatcher(char)
    for _, c in ipairs(aimSoundConns) do
        pcall(function() c:Disconnect() end)
    end
    aimSoundConns = {}

    for _, s in ipairs(char:GetDescendants()) do
        if s:IsA("Sound") then
            local c = hookMySound(s)
            if c then table.insert(aimSoundConns, c) end
        end
    end
    table.insert(aimSoundConns, char.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then
            local c = hookMySound(d)
            if c then table.insert(aimSoundConns, c) end
        end
    end))
end

-- Match detection
local lastSurvivorAnimTime = 0

local function attachAnimActivity(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:WaitForChild("Animator", 5)
    if not anim then return end
    anim.AnimationPlayed:Connect(function(track)
        local p = track.Priority
        if p == Enum.AnimationPriority.Movement
           or p == Enum.AnimationPriority.Idle
           or p == Enum.AnimationPriority.Core then
            lastSurvivorAnimTime = os.clock()
        end
    end)
end

local function runMatchScan()
    local myRoot = aimGetRoot(LocalPlayer.Character)
    local center = myRoot and myRoot.Position or Vector3.new(0, 50, 0)
    local parts
    local okq = pcall(function()
        parts = Workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(1000, 2000, 1000))
    end)
    if not okq or not parts then return false end
    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model.Parent and model.Parent.Name == "Killers" then
            return true
        end
    end
    return false
end

local function isPlayingSurvivor()
    if aimGetMyRole() ~= "Survivors" then return false end
    return (os.clock() - lastSurvivorAnimTime) < 3
end

-- Character attach
local function aimAttachToCharacter(char)
    if char ~= LocalPlayer.Character then return end

    local t0 = os.clock()
    while not char:GetAttribute("CharacterName") and os.clock() - t0 < 3 do
        task.wait(0.1)
    end

    loadMyAbilityIds(char)
    task.spawn(attachAnimWatcher, char)
    task.spawn(attachSoundWatcher, char)
    task.spawn(attachAnimActivity, char)

    local n, s = 0, 0
    for _ in pairs(aimAnimIds)  do n += 1 end
    for _ in pairs(aimSoundIds) do s += 1 end
    if n + s > 0 then
        aimNotify("✓ Aim Ready",
            string.format("%s — %d anim / %d sound", char.Name, n, s), 4)
    end
end

if LocalPlayer.Character then
    task.spawn(aimAttachToCharacter, LocalPlayer.Character)
end
