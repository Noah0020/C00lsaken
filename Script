local HDT = { debounce = false, bind = "Ck_HDT_", dashId = 0 }
local HDT_Speed, HDT_Duration, HDT_Delay = 40, 0.6, 0.05
local HDT_Enabled = false

local function hdtNearest()
    local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not kf or not hrp then return nil end
    local best, bd = nil, math.huge
    for _, k in ipairs(kf:GetChildren()) do
        local kr = k:FindFirstChild("HumanoidRootPart")
        local kh = k:FindFirstChildOfClass("Humanoid")
        if kr and (not kh or kh.Health > 0) then
            local d = (kr.Position - hrp.Position).Magnitude
            if d < bd then best, bd = k, d end
        end
    end
    return best
end

local function hdtDash(killer)
    if HDT.debounce then return end
    local char = LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    if not killer or not killer.Parent then return end
    local kr = killer:FindFirstChild("HumanoidRootPart"); if not kr then return end
    if (kr.Position - hrp.Position).Magnitude < 2.5 then return end
    HDT.debounce = true; HDT.dashId += 1
    local thisBind = HDT.bind .. tostring(HDT.dashId)
    local startT = os.clock(); local active = true
    local oldWS, oldAR = hum.WalkSpeed, hum.AutoRotate
    local bv = Instance.new("BodyVelocity")
    bv.Name = "Ck_HDT_BV"; bv.MaxForce = Vector3.new(1e6, 0, 1e6)
    bv.Velocity = Vector3.zero; bv.Parent = hrp
    hum.WalkSpeed = HDT_Speed; hum.AutoRotate = false
    local function stop()
        if not active then return end
        active = false; HDT.debounce = false
        pcall(function() RunService:UnbindFromRenderStep(thisBind) end)
        if bv and bv.Parent then bv:Destroy() end
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed = oldWS; hum.AutoRotate = oldAR end)
        end
    end
    RunService:BindToRenderStep(thisBind, Enum.RenderPriority.Camera.Value, function()
        if not active then return end
        if not hrp.Parent or not hum.Parent or hum.Health <= 0 then stop(); return end
        if not kr.Parent or os.clock() - startT > HDT_Duration then stop(); return end
        local toK = kr.Position - hrp.Position
        local flat = Vector3.new(toK.X, 0, toK.Z)
        if flat.Magnitude < 1 then stop(); return end
        if bv and bv.Parent then bv.Velocity = flat.Unit * HDT_Speed end
        if hum.WalkSpeed ~= HDT_Speed then hum.WalkSpeed = HDT_Speed end
        if hum.AutoRotate then hum.AutoRotate = false end
        local face = Vector3.new(kr.Position.X, hrp.Position.Y, kr.Position.Z)
        pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, face) end)
    end)
    task.delay(HDT_Duration + 0.2, stop)
end

local function fireBlock(killer)
    if os.clock() - lastBlockTime < BLOCK_COOLDOWN then return end
    lastBlockTime = os.clock()
    local remote = getBlockRemote()
    if remote then
        pcall(function() remote:FireServer("UseActorAbility", { buffer.fromstring("\3\5\0\0\0Block") }) end)
    end
    local mainUI = LP.PlayerGui:FindFirstChild("MainUI")
    local ac = mainUI and mainUI:FindFirstChild("AbilityContainer")
    local btn = ac and ac:FindFirstChild("Block")
    if btn and firesignal then
        pcall(function()
            if btn.MouseButton1Down then firesignal(btn.MouseButton1Down) end
            if btn.MouseButton1Click then firesignal(btn.MouseButton1Click) end
        end)
    end
    if HDT_Enabled and killer then
        task.delay(HDT_Delay, function() if HDT_Enabled then hdtDash(killer) end end)
    end
end

local AutoBlockEnabled = false

local function checkKiller(killer)
    if not AutoBlockEnabled then return end
    if not LP.Character then return end
    local curLastUsed = killer:GetAttribute("AbilityLastUsed") or 0
    local curUsed = killer:GetAttribute("AbilitiesUsed") or 0
    local st = blockPerKiller[killer]
    if not st then
        blockPerKiller[killer] = { lastUsed = curLastUsed, used = curUsed, locked = false }
        return
    end
    local lastUsedInc = curLastUsed > st.lastUsed
    local usedInc = curUsed > st.used
    if usedInc then st.locked = true end
    if lastUsedInc and not st.locked then
        activeBlocks[killer] = os.clock() + BlockConfig.WindowDuration
    end
    if lastUsedInc and st.locked then st.locked = false end
    st.lastUsed = curLastUsed
    st.used = curUsed
end

